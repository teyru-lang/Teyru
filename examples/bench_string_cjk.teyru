// Strings whose characters are not ASCII: concatenation, a charAt walk and a
// substring. bench_string cannot see the cost of indexing a UTF-16 string over
// UTF-8 storage, because for ASCII the two agree and the fast path answers
// without translating anything. Here every index has to be translated.
//
// The concatenated part and the walked part are counted separately in the
// output, so a change that makes one of them slower and the other faster cannot
// hide in a single total.
//
// The two sides count the same thing now: a string is indexed by UTF-16 code
// unit, so the join's length is the same number here and in Java, and
// charAt(i) == '\u4e2d' holds where Java's does. The row is a fair comparison
// at neither scale being a different amount of work -- scripts/bench.sh prints
// a ratio for it, and the numbers it used to print are in AGENTS.md section 10
// beside the change that made them agree.
//
class BenchStringCjk {
  public static void main(String[] args) {
    int n = 200000
    if (args.length > 0) {
      n = Integer.parseInt(args[0])
    }
    String base = "中文"
    String emoji = "😀"

    long built = 0
    for (int i = 0 : i < n : i++) {
      String s = base + "-" + i + emoji
      built += s.length()
    }

    StringBuilder sb = new StringBuilder()
    for (int i = 0 : i < 1000 : i++) {
      sb.append("中文")
    }
    String text = sb.toString()
    long walked = 0
    for (int i = 0 : i < text.length() : i++) {
      if (text.charAt(i) == '中') {
        walked += 1
      }
    }
    long sliced = text.substring(1, 5).length()
    System.out.println("concat=" + built + " walked=" + walked + " sliced=" + sliced)
  }
}
