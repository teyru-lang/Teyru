package teyru

// Number is the supertype of the numeric wrappers, exactly as in Java: the six
// conversions are abstract here and every wrapper implements all of them, the
// narrowings by Java's narrowing conversion rules.
abstract class Number extends Object {
  public abstract int intValue()
  public abstract long longValue()
  public abstract double doubleValue()
  public abstract float floatValue()
  public abstract byte byteValue()
  public abstract short shortValue()
}

/* The wrappers carry their own value.
 *
 * Every wrapper in this file has one instance field, `value`, and the
 * constructor that fills it; `valueOf` allocates one, and each conversion,
 * hash, comparison, equality and text form below is written over that field.
 * The runtime used to own the payload: `ty_box_int` allocated a `tyintbox` and
 * `ty_unbox_int` read it, and the seventy-odd helpers around them were C
 * functions the compiler called by name. The class is the wrapper now, the field
 * is the box, and the only thing left in C is the allocation underneath `new`
 * (see AGENTS.md section 10).
 *
 * The field is named `value` and typed with the wrapper's own primitive, so the
 * generated C struct is the same size and shape the runtime's `tyintbox`,
 * `tylongbox`, ... are: the compiler checks that agreement where the struct is
 * written (emit.go's structOf), and the runtime keeps its own view of the same
 * bytes for the reflection path, which reads a field through a raw pointer.
 *
 * The classes are final, as they are in Java. That is what makes `o instanceof
 * Integer` the class test Java's equals contract asks for -- an Integer never
 * equals a Long, and neither of them a subclass -- and it is the reason a call
 * to intValue() is a direct call rather than a dispatch.
 *
 * Java's parse helpers stay: the parsing methods below are still written the way
 * the JDK writes them, a native predicate followed by a native conversion, so
 * that the NumberFormatException they raise is the prelude's own class and not
 * one the runtime cannot name. */

final class Byte extends Number implements Comparable<Byte> {
  /* Java's Byte.TYPE: the class byte.class denotes, so a program that writes one
     and a program that writes the other are holding the same object. */
  public static final Class TYPE = byte.class
  public static final byte MIN_VALUE = -128
  public static final byte MAX_VALUE = 127
  public static final int SIZE = 8
  public static final int BYTES = 1

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Byte()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private byte value

  /* Java caches every byte, so `Byte.valueOf` answers the same object for all
     256 values and `Byte a = 1; Byte b = 1; a == b` is true (JLS 5.1.7 requires
     the cache for -128..127 and the JDK's ByteCache covers the whole range).
     The array is built by a method rather than written out because the values
     are the index minus 128, and the method is declared before the field
     because a class's members are read top to bottom here. `new Byte()` and not
     `valueOf` inside it: the cache cannot be filled by the factory that reads
     it. */
  private static Byte[] fillCache() {
    Byte[] c = new Byte[256]
    for (int i = 0 : i < 256 : i++) {
      Byte b = new Byte()
      b.value = (byte) (i - 128)
      c[i] = b
    }
    return c
  }
  private static final Byte[] CACHE = fillCache()

  public static Byte valueOf(byte v) {
    return CACHE[v + 128]
  }
  public static Byte valueOf(String s) {
    return valueOf(parseByte(s))
  }
  public static Byte valueOf(String s, int radix) {
    return valueOf(parseByte(s, radix))
  }
  /* Byte.parseByte is Integer.parseInt with a range test around it, which is
     how the JDK writes it too: the digits and the sign are the int parser's
     business, the byte's range is this class's. */
  public static byte parseByte(String s) {
    return parseByte(s, 10)
  }
  public static byte parseByte(String s, int radix) {
    int v = Integer.parseInt(s, radix)
    if (v < -128 || v > 127) {
      throw new NumberFormatException("Value out of range. Value:\"" + s + "\" Radix:" + radix)
    }
    return (byte) v
  }
  public static String toString(byte v) {
    return Integer.toString((int) v)
  }
  public static int compare(byte a, byte b) {
    return a < b ? -1 : (a > b ? 1 : 0)
  }
  public static int hashCode(byte v) {
    return v
  }
  public static int toUnsignedInt(byte x) {
    return x & 0xFF
  }
  public static long toUnsignedLong(byte x) {
    return x & 0xFFL
  }

  public byte byteValue() {
    return value
  }
  public int hashCode() {
    return value
  }
  public String toString() {
    return Integer.toString((int) value)
  }
  public int intValue() {
    return value
  }
  public long longValue() {
    return value
  }
  public double doubleValue() {
    return value
  }
  public float floatValue() {
    return value
  }
  public short shortValue() {
    return value
  }
  /* Every wrapper's equals is the Java contract -- the class first, the value
     second -- which is why an Integer never equals a Long and a Boolean.TRUE
     never equals an Integer holding 1. The runtime used to decide the class
     test once for all eight wrappers by comparing the two boxes' tyclass
     pointers (ty_box_equals); with the class final, `instanceof` says the same
     thing and says it in the language. */
  public boolean equals(Object o) {
    return o instanceof Byte && ((Byte) o).value == value
  }
  public int compareTo(Byte o) {
    return compare(byteValue(), o.byteValue())
  }
}

final class Short extends Number implements Comparable<Short> {
  /* Java's Short.TYPE: the class short.class denotes, so a program that writes one
     and a program that writes the other are holding the same object. */
  public static final Class TYPE = short.class
  public static final short MIN_VALUE = -32768
  public static final short MAX_VALUE = 32767
  public static final int SIZE = 16
  public static final int BYTES = 2

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Short()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private short value

  /* Java's cache for Short, the same -128..127 range Integer and Long use, so
     `Short a = 127; Short b = 127; a == b` is true and 128 is a fresh box. */
  private static Short[] fillCache() {
    Short[] c = new Short[256]
    for (int i = 0 : i < 256 : i++) {
      Short b = new Short()
      b.value = (short) (i - 128)
      c[i] = b
    }
    return c
  }
  private static final Short[] CACHE = fillCache()

  public static Short valueOf(short v) {
    if (v >= -128 && v <= 127) {
      return CACHE[v + 128]
    }
    Short b = new Short()
    b.value = v
    return b
  }
  public static Short valueOf(String s) {
    return valueOf(parseShort(s))
  }
  public static Short valueOf(String s, int radix) {
    return valueOf(parseShort(s, radix))
  }
  public static short parseShort(String s) {
    return parseShort(s, 10)
  }
  public static short parseShort(String s, int radix) {
    int v = Integer.parseInt(s, radix)
    if (v < -32768 || v > 32767) {
      throw new NumberFormatException("Value out of range. Value:\"" + s + "\" Radix:" + radix)
    }
    return (short) v
  }
  public static String toString(short v) {
    return Integer.toString((int) v)
  }
  public static int compare(short a, short b) {
    return a < b ? -1 : (a > b ? 1 : 0)
  }
  public static int hashCode(short v) {
    return v
  }
  public static int toUnsignedInt(short x) {
    return x & 0xFFFF
  }
  public static long toUnsignedLong(short x) {
    return x & 0xFFFFL
  }

  public short shortValue() {
    return value
  }
  public int hashCode() {
    return value
  }
  public String toString() {
    return Integer.toString((int) value)
  }
  public int intValue() {
    return value
  }
  public long longValue() {
    return value
  }
  public double doubleValue() {
    return value
  }
  public float floatValue() {
    return value
  }
  public byte byteValue() {
    return (byte) value
  }
  public boolean equals(Object o) {
    return o instanceof Short && ((Short) o).value == value
  }
  public int compareTo(Short o) {
    return compare(shortValue(), o.shortValue())
  }
}

final class Integer extends Number implements Comparable<Integer> {
  /* Java's Integer.TYPE: the class int.class denotes, so a program that writes one
     and a program that writes the other are holding the same object. */
  public static final Class TYPE = int.class
  public static final int MIN_VALUE = -2147483648
  public static final int MAX_VALUE = 2147483647
  public static final int SIZE = 32
  public static final int BYTES = 4

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Integer()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private int value

  public static int parseInt(String s) {
    return parseInt(s, 10)
  }
  /* The radix test comes first, then the null test, then the digits: Java
     answers a radix of 1 or of 37 with a message about the radix whatever the
     string is, and a null string with a message about the string. */
  public static int parseInt(String s, int radix) {
    if (radix < 2 || radix > 36) {
      throw new NumberFormatException("radix " + radix + " was thrown")
    }
    if (s == null) {
      throw new NumberFormatException("Cannot parse null string")
    }
    if (!parsable(s, radix)) {
      if (radix == 10) {
        throw new NumberFormatException("For input string: \"" + s + "\"")
      }
      throw new NumberFormatException("For input string: \"" + s + "\" under radix " + radix)
    }
    return parseIntDigits(s, radix)
  }
  private static native boolean parsable(String s, int radix)
  private static native int parseIntDigits(String s, int radix)

  /* Java's Integer cache. It is what makes `Integer.valueOf(127) ==
     Integer.valueOf(127)` true, and, because the compiler emits a call to this
     method for every autoboxing site, what makes `Integer a = 127; Integer b =
     127; a == b` true as well -- the identity is observable, so the box cannot
     be a fresh allocation and the language says so. 128 and above are two
     different objects, which the same test asserts. */
  private static Integer[] fillCache() {
    Integer[] c = new Integer[256]
    for (int i = 0 : i < 256 : i++) {
      Integer b = new Integer()
      b.value = i - 128
      c[i] = b
    }
    return c
  }
  private static final Integer[] CACHE = fillCache()

  public static Integer valueOf(int v) {
    if (v >= -128 && v <= 127) {
      return CACHE[v + 128]
    }
    Integer b = new Integer()
    b.value = v
    return b
  }
  public static Integer valueOf(String s) {
    return valueOf(parseInt(s))
  }
  public static Integer valueOf(String s, int radix) {
    return valueOf(parseInt(s, radix))
  }
  public static int compare(int a, int b) {
    return a < b ? -1 : (a > b ? 1 : 0)
  }
  public static native int compareUnsigned(int a, int b)
  public static int max(int a, int b) {
    return a >= b ? a : b
  }
  public static int min(int a, int b) {
    return a <= b ? a : b
  }
  public static int sum(int a, int b) {
    return a + b
  }
  public static native int signum(int v)
  public static native int bitCount(int v)
  public static native int numberOfLeadingZeros(int v)
  public static native int numberOfTrailingZeros(int v)
  public static native int highestOneBit(int v)
  public static native int lowestOneBit(int v)
  public static native int reverse(int v)
  public static native int reverseBytes(int v)
  public static native int rotateLeft(int v, int distance)
  public static native int rotateRight(int v, int distance)
  public static int hashCode(int v) {
    return v
  }

  public static String toString(int v) {
    return String.valueOf(v)
  }
  /* Signed in every radix, as Java's is: Integer.toString(-1, 16) is "-1",
     while toHexString(-1) is "ffffffff" -- the binary, octal and hex forms
     read the value as unsigned, which is what makes them useful for masks. */
  public static native String toString(int v, int radix)
  public static String toBinaryString(int v) {
    return toUnsignedString(v, 2)
  }
  public static String toOctalString(int v) {
    return toUnsignedString(v, 8)
  }
  public static String toHexString(int v) {
    return toUnsignedString(v, 16)
  }
  public static String toUnsignedString(int v) {
    return toUnsignedString(v, 10)
  }
  public static native String toUnsignedString(int v, int radix)

  public int intValue() {
    return value
  }
  public int hashCode() {
    return value
  }
  public boolean equals(Object o) {
    return o instanceof Integer && ((Integer) o).value == value
  }
  public int compareTo(Integer o) {
    return compare(value, o.value)
  }
  public String toString() {
    return String.valueOf(value)
  }
  public long longValue() {
    return value
  }
  public double doubleValue() {
    return value
  }
  public float floatValue() {
    return value
  }
  public byte byteValue() {
    return (byte) value
  }
  public short shortValue() {
    return (short) value
  }
}

final class Long extends Number implements Comparable<Long> {
  /* Java's Long.TYPE: the class long.class denotes, so a program that writes one
     and a program that writes the other are holding the same object. */
  public static final Class TYPE = long.class
  public static final long MIN_VALUE = -9223372036854775808L
  public static final long MAX_VALUE = 9223372036854775807L
  public static final int SIZE = 64
  public static final int BYTES = 8

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Long()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private long value

  public static long parseLong(String s) {
    return parseLong(s, 10)
  }
  public static long parseLong(String s, int radix) {
    if (radix < 2 || radix > 36) {
      throw new NumberFormatException("radix " + radix + " was thrown")
    }
    if (s == null) {
      throw new NumberFormatException("Cannot parse null string")
    }
    if (!parsableLong(s, radix)) {
      if (radix == 10) {
        throw new NumberFormatException("For input string: \"" + s + "\"")
      }
      throw new NumberFormatException("For input string: \"" + s + "\" under radix " + radix)
    }
    return parseLongDigits(s, radix)
  }
  private static native boolean parsableLong(String s, int radix)
  private static native long parseLongDigits(String s, int radix)

  /* Java's Long cache, the same range and the same reason as Integer's. */
  private static Long[] fillCache() {
    Long[] c = new Long[256]
    for (int i = 0 : i < 256 : i++) {
      Long b = new Long()
      b.value = i - 128
      c[i] = b
    }
    return c
  }
  private static final Long[] CACHE = fillCache()

  public static Long valueOf(long v) {
    if (v >= -128 && v <= 127) {
      return CACHE[(int) v + 128]
    }
    Long b = new Long()
    b.value = v
    return b
  }
  public static Long valueOf(String s) {
    return valueOf(parseLong(s))
  }
  public static Long valueOf(String s, int radix) {
    return valueOf(parseLong(s, radix))
  }
  public static int compare(long a, long b) {
    return a < b ? -1 : (a > b ? 1 : 0)
  }
  public static native int compareUnsigned(long a, long b)
  public static long max(long a, long b) {
    return a >= b ? a : b
  }
  public static long min(long a, long b) {
    return a <= b ? a : b
  }
  public static long sum(long a, long b) {
    return a + b
  }
  public static native int signum(long v)
  public static native int bitCount(long v)
  public static native int numberOfLeadingZeros(long v)
  public static native int numberOfTrailingZeros(long v)
  public static native long highestOneBit(long v)
  public static native long lowestOneBit(long v)
  public static native long reverse(long v)
  public static native long reverseBytes(long v)
  public static native long rotateLeft(long v, int distance)
  public static native long rotateRight(long v, int distance)
  /* Long.hashCode(long) is the two halves folded together -- Java defines it
     that way so that a map keyed by the box and a map keyed by the primitive
     agree. */
  public static int hashCode(long v) {
    return (int) (v ^ (v >>> 32))
  }

  public static String toString(long v) {
    return String.valueOf(v)
  }
  public static native String toString(long v, int radix)
  public static String toBinaryString(long v) {
    return toUnsignedString(v, 2)
  }
  public static String toOctalString(long v) {
    return toUnsignedString(v, 8)
  }
  public static String toHexString(long v) {
    return toUnsignedString(v, 16)
  }
  public static String toUnsignedString(long v) {
    return toUnsignedString(v, 10)
  }
  public static native String toUnsignedString(long v, int radix)

  public long longValue() {
    return value
  }
  public int intValue() {
    return (int) value
  }
  public int hashCode() {
    return hashCode(value)
  }
  public boolean equals(Object o) {
    return o instanceof Long && ((Long) o).value == value
  }
  public int compareTo(Long o) {
    return compare(value, o.value)
  }
  public String toString() {
    return String.valueOf(value)
  }
  public double doubleValue() {
    return value
  }
  public float floatValue() {
    return (float) value
  }
  public byte byteValue() {
    return (byte) value
  }
  public short shortValue() {
    return (short) value
  }
}

final class Float extends Number implements Comparable<Float> {
  /* Java's Float.TYPE: the class float.class denotes, so a program that writes one
     and the program that writes the other are holding the same object. */
  public static final Class TYPE = float.class
  public static final float MAX_VALUE = 3.4028235E38f
  public static final float MIN_VALUE = 1.4E-45f
  public static final float POSITIVE_INFINITY = 1.0f / 0.0f
  public static final float NEGATIVE_INFINITY = -1.0f / 0.0f
  public static final float NaN = 0.0f / 0.0f
  public static final int SIZE = 32
  public static final int BYTES = 4

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Float()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private float value

  public static float parseFloat(String s) {
    if (s == null) {
      throw new NumberFormatException("Cannot parse null string")
    }
    if (!parsableFloat(s)) {
      throw new NumberFormatException("For input string: \"" + s + "\"")
    }
    return parseFloatDigits(s)
  }
  private static native boolean parsableFloat(String s)
  private static native float parseFloatDigits(String s)

  public static Float valueOf(float v) {
    Float b = new Float()
    b.value = v
    return b
  }
  public static Float valueOf(String s) {
    return valueOf(parseFloat(s))
  }
  /* Java's Float.compare: the numeric order first, and only for values that
     compare equal numerically (the two zeros, NaN) the bit order, which puts
     -0.0 below 0.0 and NaN above everything. */
  public static int compare(float a, float b) {
    if (a < b) {
      return -1
    }
    if (a > b) {
      return 1
    }
    int x = floatToIntBits(a)
    int y = floatToIntBits(b)
    return x == y ? 0 : (x < y ? -1 : 1)
  }
  public static native float max(float a, float b)
  public static native float min(float a, float b)
  public static float sum(float a, float b) {
    return a + b
  }
  public static native boolean isNaN(float v)
  public static native boolean isInfinite(float v)
  public static native boolean isFinite(float v)
  /* Float.hashCode(float) is the bits with every NaN collapsed to one value,
     which is what floatToIntBits answers; a Float's hashCode used to fold the
     raw bits, so the two zeros agreed and the NaNs did not. */
  public static int hashCode(float v) {
    return floatToIntBits(v)
  }
  public static native int floatToIntBits(float v)
  public static native int floatToRawIntBits(float v)
  public static native float intBitsToFloat(int bits)

  public static String toString(float v) {
    return String.valueOf(v)
  }

  public float floatValue() {
    return value
  }
  public int hashCode() {
    return hashCode(value)
  }
  public boolean equals(Object o) {
    return o instanceof Float && floatToIntBits(value) == floatToIntBits(((Float) o).value)
  }
  public int compareTo(Float o) {
    return compare(value, o.value)
  }
  public String toString() {
    return String.valueOf(value)
  }
  /* The integral narrowings go through long, which is the chain the runtime has
     always used for a floating payload -- the six Number conversions were one
     helper per target type, `(int64_t)` first for a float or a double. Java's
     floating-to-integral narrowing saturates where C's is undefined, and that
     pre-existing difference is not this file's to change: written this way, a
     program that narrowed an out-of-range value prints what it printed before. */
  public int intValue() {
    return (int) (long) value
  }
  public long longValue() {
    return (long) value
  }
  public double doubleValue() {
    return value
  }
  public byte byteValue() {
    return (byte) (long) value
  }
  public short shortValue() {
    return (short) (long) value
  }
}

final class Double extends Number implements Comparable<Double> {
  /* Java's Double.TYPE: the class double.class denotes, so a program that writes one
     and a program that writes the other are holding the same object. */
  public static final Class TYPE = double.class
  public static final double MAX_VALUE = 1.7976931348623157E308
  public static final double MIN_VALUE = 4.9E-324
  public static final double POSITIVE_INFINITY = 1.0 / 0.0
  public static final double NEGATIVE_INFINITY = -1.0 / 0.0
  public static final double NaN = 0.0 / 0.0
  public static final int SIZE = 64
  public static final int BYTES = 8

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Double()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private double value

  public static double parseDouble(String s) {
    if (s == null) {
      throw new NumberFormatException("Cannot parse null string")
    }
    if (!parsableDouble(s)) {
      throw new NumberFormatException("For input string: \"" + s + "\"")
    }
    return parseDoubleDigits(s)
  }
  private static native boolean parsableDouble(String s)
  private static native double parseDoubleDigits(String s)

  public static Double valueOf(double v) {
    Double b = new Double()
    b.value = v
    return b
  }
  public static Double valueOf(String s) {
    return valueOf(parseDouble(s))
  }
  /* Java's Double.compare, and the reason Double.equals needs doubleToLongBits:
     the two zeros differ, NaN equals NaN, and equal values hash alike. */
  public static int compare(double a, double b) {
    if (a < b) {
      return -1
    }
    if (a > b) {
      return 1
    }
    long x = doubleToLongBits(a)
    long y = doubleToLongBits(b)
    return x == y ? 0 : (x < y ? -1 : 1)
  }
  public static native double max(double a, double b)
  public static native double min(double a, double b)
  public static double sum(double a, double b) {
    return a + b
  }
  public static native boolean isNaN(double v)
  public static native boolean isInfinite(double v)
  public static native boolean isFinite(double v)
  public static int hashCode(double v) {
    long bits = doubleToLongBits(v)
    return (int) (bits ^ (bits >>> 32))
  }
  public static native long doubleToLongBits(double v)
  public static native long doubleToRawLongBits(double v)
  public static native double longBitsToDouble(long bits)

  public static String toString(double v) {
    return String.valueOf(v)
  }

  public double doubleValue() {
    return value
  }
  public int hashCode() {
    return hashCode(value)
  }
  public boolean equals(Object o) {
    return o instanceof Double && doubleToLongBits(value) == doubleToLongBits(((Double) o).value)
  }
  public int compareTo(Double o) {
    return compare(value, o.value)
  }
  public String toString() {
    return String.valueOf(value)
  }
  /* See Float: the integral narrowings go through long, the chain the runtime
     has always used for a floating payload. */
  public int intValue() {
    return (int) (long) value
  }
  public long longValue() {
    return (long) value
  }
  public float floatValue() {
    return (float) value
  }
  public byte byteValue() {
    return (byte) (long) value
  }
  public short shortValue() {
    return (short) (long) value
  }
}

final class Character extends Object implements Comparable<Character> {
  /* Java's Character.TYPE: the class char.class denotes, so a program that writes one
     and the program that writes the other are holding the same object. */
  public static final Class TYPE = char.class
  public static final char MIN_VALUE = 0
  public static final char MAX_VALUE = 65535
  public static final int MIN_RADIX = 2
  public static final int MAX_RADIX = 36
  public static final int SIZE = 16
  public static final int BYTES = 2

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Character()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private char value

  public static Character valueOf(char c) {
    if (c <= 127) {
      return CACHE[c]
    }
    Character b = new Character()
    b.value = c
    return b
  }
  /* Java's Character cache is 0..127, a smaller range than the numbers' -128..127
     and for a related reason: the first 128 code points are the printing
     characters of every encoding, so those are the ones a program compares by
     identity. `Character.valueOf('a') == Character.valueOf('a')` is true and the
     same comparison for a CJK character is false, both asserted by the test. */
  private static Character[] fillCache() {
    Character[] c = new Character[128]
    for (int i = 0 : i < 128 : i++) {
      Character b = new Character()
      b.value = (char) i
      c[i] = b
    }
    return c
  }
  private static final Character[] CACHE = fillCache()
  public static native boolean isDigit(char c)
  public static native boolean isLetter(char c)
  public static native boolean isLetterOrDigit(char c)
  public static native boolean isAlphabetic(char c)
  public static native boolean isUpperCase(char c)
  public static native boolean isLowerCase(char c)
  public static native boolean isWhitespace(char c)
  public static native char toUpperCase(char c)
  public static native char toLowerCase(char c)
  public static native int getNumericValue(char c)
  public static native int digit(char c, int radix)
  public static int compare(char a, char b) {
    return a < b ? -1 : (a > b ? 1 : 0)
  }
  public static String toString(char c) {
    return String.valueOf(c)
  }
  public static int hashCode(char c) {
    return c
  }

  public char charValue() {
    return value
  }
  public int hashCode() {
    return value
  }
  public boolean equals(Object o) {
    return o instanceof Character && ((Character) o).value == value
  }
  public int compareTo(Character o) {
    return compare(value, o.value)
  }
  public String toString() {
    return String.valueOf(value)
  }
}

final class Boolean extends Object implements Comparable<Boolean> {
  /* Java's Boolean.TYPE: the class boolean.class denotes, so a program that writes one
     and the program that writes the other are holding the same object. */
  public static final Class TYPE = boolean.class

  /* The two constants are built by a private factory rather than by
     `Boolean.valueOf`, which cannot be used to make them because valueOf
     answers them: that would be a static initializer reading the field it is
     initializing. The version this replaces called valueOf(true) twice, and
     valueOf allocated a fresh box every time, so TRUE and FALSE were two
     objects nobody else ever got -- `Boolean a = true; Boolean b = true; a == b`
     was false where Java's is true. The JDK writes the same two `new
     Boolean(...)` constants for the same reason. */
  private static Boolean make(boolean v) {
    Boolean b = new Boolean()
    b.value = v
    return b
  }
  public static final Boolean TRUE = make(true)
  public static final Boolean FALSE = make(false)

  /* The value is the wrapper's whole state, and `valueOf` is the only thing
     that fills it: no constructor is declared, so `new Boolean()` and
     `Class.newInstance()` build the same zero-valued wrapper they built when
     the runtime owned the payload, and `valueOf` is the one factory. */
  private boolean value

  /* Java's parser is case-insensitive: only "true" in any case is true, and a
     null is false. */
  public static boolean parseBoolean(String s) {
    return s != null && s.equalsIgnoreCase("true")
  }
  public static Boolean valueOf(String s) {
    return parseBoolean(s) ? TRUE : FALSE
  }
  public static Boolean valueOf(boolean v) {
    if (v) {
      return TRUE
    }
    return FALSE
  }
  public static String toString(boolean v) {
    return String.valueOf(v)
  }
  public static int compare(boolean a, boolean b) {
    if (a == b) {
      return 0
    }
    return a ? 1 : -1
  }
  /* Boolean.hashCode is the class hash and not the raw value the unboxing
     helper used to answer with; a Boolean's %h used to print 1. */
  public static int hashCode(boolean v) {
    return v ? 1231 : 1237
  }
  public static boolean logicalAnd(boolean a, boolean b) {
    return a && b
  }
  public static boolean logicalOr(boolean a, boolean b) {
    return a || b
  }
  public static boolean logicalXor(boolean a, boolean b) {
    return a != b
  }
  public static boolean logicalNot(boolean a) {
    return !a
  }

  public boolean booleanValue() {
    return value
  }
  public int hashCode() {
    return hashCode(value)
  }
  public boolean equals(Object o) {
    return o instanceof Boolean && ((Boolean) o).value == value
  }
  public String toString() {
    return String.valueOf(value)
  }
  public int compareTo(Boolean o) {
    return compare(booleanValue(), o.booleanValue())
  }
}
