package teyru

// WebSocket, as RFC 6455 defines it: the upgrade handshake, the frame codec, and
// the session a program sends and receives on.
//
// The handshake is the part a client checks: the server answers the
// Sec-WebSocket-Key the client sent with the base64 of the SHA-1 of that key and
// a fixed string, and a client that does not see the answer it computed itself
// closes the connection. That string is below, and the hash is in the runtime
// (tyrt_net.c) because the library has no other use for one.
//
// A frame is a byte of flags and opcode, a length that may take one, three or
// nine bytes, a mask a client always sends, and the payload. The payloads
// matter more than the flags here: a text frame is a message, a ping is
// something to answer with a pong, a close ends the conversation, and a
// fragmented message is several frames whose first one is not final.

// Sha1 is the one hash the handshake needs, kept out of the public surface: a
// program that wants a hash can write one, and this exists because RFC 6455
// asks for this one.
class Sha1 {
  static native byte[] of(byte[] data)
}

// WebSocketMapping declares that a class answers a WebSocket on a path. It is
// what @GetMapping is to a controller: the class implements WebSocketHandler,
// the annotation says where it is reachable, and the scanner registers it --
// so a WebSocket is declared the way everything else in this library is, and a
// handler that is a bean can be injected like any other.
@interface WebSocketMapping {
  String value() default ""
}

/* WebSocketProtocolException is a frame this server refuses, carrying the close
   code the peer is told before the connection ends. The code is the whole of
   what the protocol gives a peer to diagnose with, which is why it is a field
   rather than a sentence:

     1001  going away          the session was idle for too long
     1002  protocol error      a client frame that was not masked, a control
                               frame that was too long or fragmented, an opcode
                               nobody defined, a continuation with nothing to
                               continue
     1007  invalid frame data  a text message that is not UTF-8
     1009  message too big     a message over the limit, fragments included

   It is an IOException because that is what the frame reader's callers already
   handle, and a session that ends is a session that ends whichever way it
   went. */
class WebSocketProtocolException extends IOException {
  public int code

  public WebSocketProtocolException(int code, String message) {
    super(message)
    this.code = code
  }
}

/* WebSocketLimits is what one session is held to. Two numbers, because a
   WebSocket is the one thing here that has no answer to give and no length to
   declare: a peer can hold a session open for as long as it likes, and it can
   send a message as large as it likes unless the server says otherwise.

   maxMessageBytes is the whole of a message, fragments included -- a client
   that sends a message in pieces is sending several frames and one message --
   and maxControlBytes is the 125 bytes RFC 6455 allows a control frame, which
   is a limit of the protocol rather than a choice. */
class WebSocketLimits {
  public int maxMessageBytes = 1048576
  public int idleTimeoutMs = 60000

  public static final int MAX_CONTROL_BYTES = 125

  public WebSocketLimits() {
  }

  public WebSocketLimits(int maxMessageBytes, int idleTimeoutMs) {
    this.maxMessageBytes = maxMessageBytes
    this.idleTimeoutMs = idleTimeoutMs
  }
}

// WebSocketSession is one connection after the upgrade: what a program sends on
// and what tells it the connection ended.
class WebSocketSession {
  private Socket socket
  private SocketOutputStream out
  private boolean open = true
  private String path

  public WebSocketSession(Socket socket, SocketOutputStream out, String path) {
    this.socket = socket
    this.out = out
    this.path = path
  }

  public String getPath() {
    return path
  }

  public boolean isOpen() {
    return open
  }

  // send writes a text frame. A message that arrives whole is sent whole, which
  // is what a caller with a String has.
  public void send(String text) {
    if (open == false) {
      throw new IllegalStateException("the WebSocket is closed")
    }
    out.write(WebSocketFrame.encode(WebSocketFrame.TEXT, text.getBytes()))
    out.flush()
  }

  public void send(byte[] data) {
    if (open == false) {
      throw new IllegalStateException("the WebSocket is closed")
    }
    out.write(WebSocketFrame.encode(WebSocketFrame.BINARY, data))
    out.flush()
  }

  // ping and pong are the control frames a peer answers with a pong. A server
  // that wants to know the other end is there sends one and waits.
  public void ping(byte[] data) {
    out.write(WebSocketFrame.encode(WebSocketFrame.PING, data == null ? new byte[0] : data))
    out.flush()
  }

  // close sends the closing frame and remembers that the session is over, so a
  // send after it says so rather than writing to a socket the peer closed.
  public void close() {
    if (open == false) {
      return
    }
    open = false
    out.write(WebSocketFrame.encode(WebSocketFrame.CLOSE, new byte[0]))
    out.flush()
  }

  // ended is what the server calls when the peer closed, so a handler's onClose
  // sees a session that is no longer open.
  public void ended() {
    open = false
  }
}

// WebSocketHandler is what a program implements to answer a WebSocket. The four
// methods are the four things that can happen: the connection opens, a message
// arrives (text or binary), the connection closes. A handler that does not care
// about one of them leaves it empty, which is why the interface has all four
// rather than a listener with callbacks a program registers.
interface WebSocketHandler {
  void onOpen(WebSocketSession session)
  void onMessage(WebSocketSession session, String text)
  void onBinary(WebSocketSession session, byte[] data)
  void onClose(WebSocketSession session)
}

// WebSocketFrame is one frame, read from a stream or written to it.
class WebSocketFrame {
  public static final int CONT = 0x0
  public static final int TEXT = 0x1
  public static final int BINARY = 0x2
  public static final int CLOSE = 0x8
  public static final int PING = 0x9
  public static final int PONG = 0xa
  // 125 is the largest payload a frame's own length field holds; beyond it the
  // length moves into two or eight bytes, and 126 and 127 say which.
  public static final int SHORT_MAX = 125

  public boolean fin = true
  public int opcode = TEXT
  public byte[] payload = new byte[0]

  public boolean isControl() {
    return opcode >= 0x8
  }

  // read reads one frame from a client: the flags, the length, the mask a client
  // always sends, and the payload it unmasked.
  //
  // It refuses what RFC 6455 tells a server to fail a connection for, and says
  // which code the peer gets: a frame that is not masked (1002), a control frame
  // over 125 bytes or one that is fragmented (1002), an opcode nobody defined
  // (1002), a frame larger than the message limit (1009). Returning null is
  // reserved for the one case that is not a failure -- the connection ended
  // between frames -- because a peer that goes away is not a peer that erred.
  //
  // Both waits are totals and neither blocks longer than the poll: the first
  // byte of a frame waits out the idle timeout, and a frame that has started has
  // the same timeout to finish. That is what makes an idle session end rather
  // than sit for the afternoon, and what keeps a thread blocked here from
  // holding the collector, which cannot stop a thread inside the C library's
  // recv().
  public static WebSocketFrame read(Socket socket, SocketInputStream in, WebSocketLimits limits) {
    long idleDeadline = System.currentTimeMillis() + (long) limits.idleTimeoutMs
    int first = readByteWithin(socket, in, idleDeadline, true)
    if (first == END_OF_STREAM) {
      return null
    }
    long deadline = System.currentTimeMillis() + (long) limits.idleTimeoutMs
    int second = readByteWithin(socket, in, deadline, false)
    if (second == END_OF_STREAM) {
      return null
    }
    WebSocketFrame f = new WebSocketFrame()
    f.fin = (first & 0x80) != 0
    f.opcode = first & 0x0f
    boolean masked = (second & 0x80) != 0
    long len = second & 0x7f
    if (len == 126) {
      len = ((long) readByteWithin(socket, in, deadline, false) << 8) |
          (long) readByteWithin(socket, in, deadline, false)
    } else if (len == 127) {
      len = 0
      for (int i = 0 : i < 8 : i++) {
        len = (len << 8) | (long) readByteWithin(socket, in, deadline, false)
      }
    }
    if (opcodeOf(f.opcode) == false) {
      throw new WebSocketProtocolException(1002, "opcode " + f.opcode + " is not one the protocol defines")
    }
    // A client MUST mask every frame it sends, and a server that reads an
    // unmasked one has no idea whether it is reading a client or a proxy
    // repeating what it was given: the mask is the proof that the bytes were
    // written by the peer this connection is to.
    if (masked == false) {
      throw new WebSocketProtocolException(1002, "a client frame must be masked")
    }
    // A control frame is a frame the protocol wants an answer to before the
    // message around it is finished, and 125 bytes is what RFC 6455 allows one
    // to carry. A fragmented control frame is a control frame two peers could
    // read in two orders, so it is refused rather than reassembled.
    if (f.isControl()) {
      if (f.fin == false) {
        throw new WebSocketProtocolException(1002, "a control frame cannot be fragmented")
      }
      if (len > (long) WebSocketLimits.MAX_CONTROL_BYTES) {
        throw new WebSocketProtocolException(1002,
            "a control frame of " + len + " bytes is over the 125 the protocol allows")
      }
    }
    // The length is a number a client wrote, and this is the only place it can
    // be checked before it is allocated: a client that says "two gigabytes" gets
    // a close of 1009 rather than two gigabytes.
    if (len > (long) limits.maxMessageBytes) {
      throw new WebSocketProtocolException(1009,
          "a frame of " + len + " bytes is over the limit of " + limits.maxMessageBytes)
    }
    byte[] mask = new byte[4]
    readFullyWithin(socket, in, mask, 0, mask.length, deadline)
    f.payload = new byte[(int) len]
    readFullyWithin(socket, in, f.payload, 0, f.payload.length, deadline)
    for (int i = 0 : i < f.payload.length : i++) {
      f.payload[i] = (byte) (f.payload[i] ^ mask[i % 4])
    }
    return f
  }

  // END_OF_STREAM is what a read that found the connection over answers, which
  // is a number no byte can be: read() answers 0..255 or -1.
  private static final int END_OF_STREAM = -1

  // POLL_MS is how long one read blocks before the clock is looked at again.
  private static final int POLL_MS = 250

  // readByteWithin reads one byte, waiting no longer than the deadline and
  // looking at the clock every poll. END_OF_STREAM is the connection over;
  // a deadline that arrives is the refusal it names.
  private static int readByteWithin(Socket socket, SocketInputStream in, long deadline, boolean idle) {
    while (true) {
      long left = deadline - System.currentTimeMillis()
      if (left <= 0) {
        if (idle) {
          throw new WebSocketProtocolException(1001, "the session was idle for longer than it is allowed")
        }
        throw new WebSocketProtocolException(1002, "a frame did not finish arriving in time")
      }
      socket.setSoTimeout((int) (left < POLL_MS ? left : POLL_MS))
      try {
        return in.read()
      } catch (SocketTimeoutException e) {
        // the poll ran out rather than the deadline: look at the clock again
      }
    }
  }

  // readFullyWithin is readFully with a deadline: the same retry on a short
  // read, and the same refusal when the clock runs out.
  private static void readFullyWithin(Socket socket, SocketInputStream in, byte[] buf, int off,
      int len, long deadline) {
    int have = 0
    while (have < len) {
      long left = deadline - System.currentTimeMillis()
      if (left <= 0) {
        throw new WebSocketProtocolException(1002, "a frame did not finish arriving in time")
      }
      socket.setSoTimeout((int) (left < POLL_MS ? left : POLL_MS))
      try {
        int n = in.read(buf, off + have, len - have)
        if (n < 0) {
          throw new EOFException("the connection ended in the middle of a frame")
        }
        have = have + n
      } catch (SocketTimeoutException e) {
        // the poll ran out rather than the deadline: look at the clock again
      }
    }
  }

  // opcodeOf answers whether this is an opcode the protocol defines: a
  // continuation, text, binary, or one of the three control frames. The rest of
  // the space is reserved, and a frame in it is a frame two implementations
  // could read differently.
  public static boolean opcodeOf(int opcode) {
    return opcode == CONT || opcode == TEXT || opcode == BINARY ||
        opcode == CLOSE || opcode == PING || opcode == PONG
  }


  // encode renders one frame. A server's frames are not masked, and its payload
  // is sent whole, so the length is what it is.
  public static byte[] encode(int opcode, byte[] payload) {
    byte[] data = payload == null ? new byte[0] : payload
    int extra = data.length <= SHORT_MAX ? 0 : (data.length <= 65535 ? 2 : 8)
    byte[] out = new byte[2 + extra + data.length]
    out[0] = (byte) (0x80 | (opcode & 0x0f))
    if (extra == 0) {
      out[1] = (byte) data.length
    } else if (extra == 2) {
      out[1] = (byte) 126
      out[2] = (byte) ((data.length >> 8) & 0xff)
      out[3] = (byte) (data.length & 0xff)
    } else {
      out[1] = (byte) 127
      long n = data.length
      for (int i = 0 : i < 8 : i++) {
        out[2 + i] = (byte) ((n >> ((7 - i) * 8)) & 0xff)
      }
    }
    for (int i = 0 : i < data.length : i++) {
      out[2 + extra + i] = data[i]
    }
    return out
  }

  // text is a frame's payload read back as the text of a message, which is what
  // a text frame carries.
  public static String text(WebSocketFrame f) {
    return WebSocketSessionText.of(f.payload)
  }
}

// WebSocketSessionText turns a frame's payload into the text of a message. A
// text frame is UTF-8, so the bytes are read back as one.
class WebSocketSessionText {
  public static String of(byte[] data) {
    return Net.stringFrom(data, 0, data.length)
  }
}

// WebSocketUpgrade is the handshake, both halves of it: whether a request is
// asking for the upgrade, and the response that answers it.
class WebSocketUpgrade {
  // The magic string RFC 6455 appends to the client's key before hashing it.
  public static final String GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

  // wanted reports whether a request asks for a WebSocket on this path. The
  // three headers are the ones a client must send: the upgrade, the connection
  // token, and a version this server speaks.
  public static boolean wanted(HttpRequest req, String path, boolean handled) {
    if (handled == false || req.path.equals(path) == false) {
      return false
    }
    if (req.header("Upgrade").toLowerCase().indexOf("websocket") < 0) {
      return false
    }
    if (req.header("Connection").toLowerCase().indexOf("upgrade") < 0) {
      return false
    }
    return req.header("Sec-WebSocket-Key").isEmpty() == false
  }

  // accept is the Sec-WebSocket-Accept a client checks: the base64 of the SHA-1
  // of the key it sent with the magic string appended.
  public static String accept(String key) {
    return Base64.encodeToString(Sha1.of((key + GUID).getBytes()))
  }

  // response is the 101 that switches the connection over.
  public static String response(String key) {
    return "HTTP/1.1 101 Switching Protocols\r\n" +
        "Upgrade: websocket\r\n" +
        "Connection: Upgrade\r\n" +
        "Sec-WebSocket-Accept: " + accept(key) + "\r\n" +
        "\r\n"
  }
}

// WebSocketConnection runs one WebSocket: the frames until the peer closes, with
// the control frames answered here and the messages handed to the handler.
class WebSocketConnection {
  // run reads frames until the connection ends. A ping is answered with a pong
  // and a close with a close, which is what the protocol asks of both ends; a
  // frame in the middle of a fragmented message is added to the message before
  // it, which is what a client that sends a large message does.
  public static void run(Socket socket, SocketInputStream in, SocketOutputStream out,
      WebSocketSession session, WebSocketHandler handler) {
    run(socket, in, out, session, handler, new WebSocketLimits())
  }

  // run is the whole of a session, and the limits are what a peer is held to:
  // how large a message may be and how long a silence is allowed, both of which
  // are questions a WebSocket asks that a request does not -- a session has no
  // answer to give and no length to declare.
  //
  // A frame that breaks the protocol ends the session with the close code that
  // says which rule it broke (RFC 6455 §7.4.1), because the code is the whole
  // of what the peer is told. A peer that goes away between frames is not a
  // failure and gets no close: there is nobody left to read it.
  public static void run(Socket socket, SocketInputStream in, SocketOutputStream out,
      WebSocketSession session, WebSocketHandler handler, WebSocketLimits limits) {
    ByteArrayOutputStream message = null
    long total = 0
    int opcode = 0
    int failure = 0
    String reason = ""
    handler.onOpen(session)
    try {
      while (session.isOpen()) {
        WebSocketFrame f = WebSocketFrame.read(socket, in, limits)
        if (f == null) {
          // the connection ended between frames: there is nobody to answer
          break
        }
        if (f.isControl()) {
          if (f.opcode == WebSocketFrame.PING) {
            out.write(WebSocketFrame.encode(WebSocketFrame.PONG, f.payload))
            out.flush()
            continue
          }
          if (f.opcode == WebSocketFrame.PONG) {
            continue
          }
          // A close from the peer is answered with a close, which is what the
          // protocol asks of both ends. The code the peer sent is not echoed:
          // what it means is the peer's to know, and an empty close says the
          // same thing about this end -- the conversation is over.
          session.ended()
          out.write(WebSocketFrame.encode(WebSocketFrame.CLOSE, new byte[0]))
          out.flush()
          break
        }
        // ---- a data frame, which is a message or part of one ----
        if (f.opcode == WebSocketFrame.CONT) {
          if (message == null) {
            throw new WebSocketProtocolException(1002,
                "a continuation frame with no message to continue")
          }
        } else {
          // A new text or binary frame before the message before it ended is
          // two messages that two readers would interleave differently.
          if (message != null) {
            throw new WebSocketProtocolException(1002,
                "a new message began before the one before it had ended")
          }
          message = new ByteArrayOutputStream()
          total = 0
          opcode = f.opcode
        }
        // The limit is on the message and not on the frame: a client that sends
        // a megabyte in a thousand fragments has sent a megabyte.
        total = total + (long) f.payload.length
        if (total > (long) limits.maxMessageBytes) {
          throw new WebSocketProtocolException(1009,
              "a message of more than " + limits.maxMessageBytes + " bytes")
        }
        message.write(f.payload, 0, f.payload.length)
        if (f.fin == false) {
          continue
        }
        byte[] bytes = message.toByteArray()
        message = null
        if (opcode == WebSocketFrame.BINARY) {
          handler.onBinary(session, bytes)
        } else {
          // A text message that is not UTF-8 is a message no two readers agree
          // on, and RFC 6455 fails the connection for it rather than letting
          // each reader replace the bytes it cannot read.
          if (WebSocketText.valid(bytes) == false) {
            throw new WebSocketProtocolException(1007, "a text message that is not UTF-8")
          }
          handler.onMessage(session, Net.stringFrom(bytes, 0, bytes.length))
        }
      }
    } catch (WebSocketProtocolException e) {
      failure = e.code
      reason = e.getMessage()
    } catch (IOException e) {
      // A peer that goes away in the middle of a frame is a connection that
      // ended, which is what the peer that goes away between frames gets: the
      // read is waiting for bytes the connection will never carry. Letting the
      // exception out would skip onClose, and a handler that holds something --
      // a subscriber, a counter -- would hold it for the life of the process.
    }
    if (failure != 0) {
      // the close that says which rule was broken, which is all the peer gets
      session.ended()
      out.write(WebSocketFrame.encode(WebSocketFrame.CLOSE, closeBody(failure, reason)))
      out.flush()
    }
    session.ended()
    handler.onClose(session)
  }

  // closeBody is what a close frame carries: the two bytes of the code, and the
  // reason when there is room for it. A close frame is a control frame, so the
  // whole of it is 125 bytes and a reason that would not fit is cut rather than
  // sent as a frame no peer may read. The room is 123 BYTES and not 123
  // characters -- that is the bound the JDK's own WebSocket holds a caller to
  // (WebSocketImpl.isLegalReason encodes the reason and checks the byte count)
  // -- and a cut leaves a whole character behind: the reason is text, RFC 6455
  // requires it to be valid UTF-8, and half a character would be answered with
  // a 1007 that says the frame was broken instead of the one that says why the
  // connection is ending.
  public static byte[] closeBody(int code, String reason) {
    byte[] text = reason == null ? new byte[0] : reason.getBytes()
    int extra = text.length
    if (extra > WebSocketLimits.MAX_CONTROL_BYTES - 2) {
      extra = textLimit(text, WebSocketLimits.MAX_CONTROL_BYTES - 2)
    }
    byte[] body = new byte[2 + extra]
    body[0] = (byte) ((code >> 8) & 0xff)
    body[1] = (byte) (code & 0xff)
    for (int i = 0 : i < extra : i++) {
      body[2 + i] = text[i]
    }
    return body
  }

  // textLimit is the most of a byte array that can be taken without cutting a
  // character in half: the largest count at or below `limit` that ends where a
  // sequence ends. The bytes come from getBytes, so what is here is a prefix of
  // well-formed UTF-8, and the only sequence that can straddle the limit is the
  // one whose last byte is at limit - 1.
  private static int textLimit(byte[] text, int limit) {
    int start = limit - 1
    while (start > 0 && (text[start] & 0xC0) == 0x80) {
      start = start - 1
    }
    int first = text[start] & 0xff
    int length = first < 0x80 ? 1 : (first < 0xE0 ? 2 : (first < 0xF0 ? 3 : 4))
    return start + length <= limit ? limit : start
  }
}

/* WebSocketText answers whether a message is valid UTF-8, which RFC 6455 asks a
   text frame to be and a binary frame not to be.

   The check is over the bytes and not over the string the bytes would become,
   and that is the point: a decoder that replaces what it cannot read turns a
   broken message into a readable one, and the server would then hand the
   handler a document the peer did not send. An overlong encoding, a surrogate,
   a code point above U+10FFFF and a truncated sequence are all refused. */
class WebSocketText {
  public static boolean valid(byte[] b) {
    int i = 0
    while (i < b.length) {
      int first = b[i] & 0xff
      if (first < 0x80) {
        i++
        continue
      }
      int need
      int code
      int least
      if (first >= 0xc2 && first <= 0xdf) {
        need = 1
        code = first & 0x1f
        least = 0x80
      } else if (first >= 0xe0 && first <= 0xef) {
        need = 2
        code = first & 0x0f
        least = 0x800
      } else if (first >= 0xf0 && first <= 0xf4) {
        need = 3
        code = first & 0x07
        least = 0x10000
      } else {
        // 0x80..0xBF is a continuation byte with nothing before it, 0xC0 and
        // 0xC1 can only encode an overlong value, and 0xF5.. would be a code
        // point no character has
        return false
      }
      if (i + need >= b.length) {
        return false
      }
      for (int k = 1 : k <= need : k++) {
        int next = b[i + k] & 0xff
        if (next < 0x80 || next > 0xbf) {
          return false
        }
        code = (code << 6) | (next & 0x3f)
      }
      if (code < least) {
        return false
      }
      if (code >= 0xd800 && code <= 0xdfff) {
        return false
      }
      if (code > 0x10ffff) {
        return false
      }
      i = i + need + 1
    }
    return true
  }
}

// WebSocketScanner registers the WebSockets a program declares, the way
// RouteScanner registers the routes: it reads the annotation off each class the
// container holds and hands the server the handler the class is.
class WebSocketScanner {
  public static int register(ApplicationContext ctx, HttpServer server) {
    int n = 0
    for (Class c : BeanRegistry.registered()) {
      Annotation a = BeanScanner.has(c.getAnnotations(), "WebSocketMapping")
      if (a == null) {
        continue
      }
      String path = a.stringValue("value")
      if (path.length() == 0) {
        path = "/" + c.getSimpleName().toLowerCase()
      }
      Object handler = ctx.getBean(c)
      if (handler instanceof WebSocketHandler == false) {
        throw new IllegalStateException(c.getName() + " is annotated @WebSocketMapping but does not implement WebSocketHandler")
      }
      server.addWebSocket(path, (WebSocketHandler) handler)
      n++
    }
    return n
  }
}
