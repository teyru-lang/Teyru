package teyru

/* The format patterns and number symbols each carried locale uses, and the one
   place they are written down.

   A pattern is locale data, not a translation: the JDK's German long date is
   "d. MMMM y" and its Japanese one is "y\u5e74M\u6708d\u65e5"; its German medium
   time is "HH:mm:ss" and its English one is "h:mm:ss\u202fa"; its Turkish percent
   is "%#,##0" (the sign in front) and its Swedish minus is U+2212. None of that
   follows from the language's name, so every row here was read out of OpenJDK
   21.0.11+10 on this machine with
   ((SimpleDateFormat) DateFormat.getXxxInstance(style, locale)).toPattern(),
   ((DecimalFormat) NumberFormat.getXxxInstance(locale)).toPattern(),
   DecimalFormatSymbols.getMinusSign() and DateFormatSymbols.getAmPmStrings().

   Row shape:
     tag, currencyPattern, numberPattern, percentPattern, minusSign,
     am, pm,
     dateFull, dateLong, dateMedium, dateShort,
     timeFull, timeLong, timeMedium, timeShort,
     dateTimeShort

   Everything else the formatters need (the separators, the zero digit, the
   currency symbol and code) is in lib/54_locale's NUMBER_DATA; this file is the
   part that is a pattern rather than a character.

   How it is verified: tests/programs/t335_locale_table.teyru formats one
   number, one currency, one percent, one long date and one medium time in all
   47 locales and compares line for line with its .java.ref's output on that
   JDK. t326_locale does the same for the locales a program is most likely to
   name, and t333_locale_case covers the case mappings. */
final class LocaleFormats {
  /* dateSymbols answers the language's row from DateSymbols, which is where the
     month and weekday names live; a language not carried answers the ROOT row,
     which is English. */
  static Object[] dateSymbols(Locale locale) {
    /* ROOT answers the root row, not English: the root bundle's "full" month
       names are the abbreviated ones, which is why the JDK prints
       "2023 Nov 14" for ROOT's long date. */
    String lang = locale.language
    for (int i = 0 : i < DateSymbols.ROWS.length : i++) {
      if (DateSymbols.ROWS[i][0].equals(lang)) {
        return DateSymbols.ROWS[i]
      }
    }
    return DateSymbols.ROWS[0]
  }

  private static Object[] row(Locale locale) {
    String tag = locale.toLanguageTag()
    for (int i = 0 : i < ROWS.length : i++) {
      if (ROWS[i][0].equals(tag)) {
        return ROWS[i]
      }
    }
    String lang = locale.language
    if (lang.length() > 0) {
      for (int i = 0 : i < ROWS.length : i++) {
        if (ROWS[i][0].equals(lang)) {
          return ROWS[i]
        }
      }
    }
    return ROWS[0]
  }

  static String currencyPattern(Locale locale) {
    return (String) row(locale)[1]
  }

  static String numberPattern(Locale locale) {
    return (String) row(locale)[2]
  }

  static String percentPattern(Locale locale) {
    return (String) row(locale)[3]
  }

  static char minusSign(Locale locale) {
    return (char) ((Integer) row(locale)[4]).intValue()
  }

  static String am(Locale locale) {
    return (String) row(locale)[5]
  }

  static String pm(Locale locale) {
    return (String) row(locale)[6]
  }

  /* style is DateFormat's FULL/LONG/MEDIUM/SHORT, which are 0..3. */
  static String datePattern(Locale locale, int style) {
    if (style < 0 || style > 3) {
      throw new IllegalArgumentException("Illegal date style: " + style)
    }
    return (String) row(locale)[7 + style]
  }

  static String timePattern(Locale locale, int style) {
    if (style < 0 || style > 3) {
      throw new IllegalArgumentException("Illegal time style: " + style)
    }
    return (String) row(locale)[11 + style]
  }

  static String dateTimeShortPattern(Locale locale) {
    return (String) row(locale)[15]
  }

  static final Object[][] ROWS = {
    { "", "\u00a4\u00a0#,##0.00", "#,##0.###", "#,##0%", 45, "AM", "PM", "y MMMM d, EEEE", "y MMMM d", "y MMM d", "y-MM-dd", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "y-MM-dd HH:mm" }, { "en", "\u00a4#,##0.00", "#,##0.###", "#,##0%", 45, "AM", "PM", "EEEE, MMMM d, y", "MMMM d, y", "MMM d, y", "M/d/yy", "h:mm:ss\u202fa zzzz", "h:mm:ss\u202fa z", "h:mm:ss\u202fa", "h:mm\u202fa", "M/d/yy, h:mm\u202fa" }, { "en-US", "\u00a4#,##0.00", "#,##0.###", "#,##0%", 45, "AM", "PM", "EEEE, MMMM d, y", "MMMM d, y", "MMM d, y", "M/d/yy", "h:mm:ss\u202fa zzzz", "h:mm:ss\u202fa z", "h:mm:ss\u202fa", "h:mm\u202fa", "M/d/yy, h:mm\u202fa" }, { "en-GB", "\u00a4#,##0.00", "#,##0.###", "#,##0%", 45, "am", "pm", "EEEE, d MMMM y", "d MMMM y", "d MMM y", "dd/MM/y", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "dd/MM/y, HH:mm" }, { "en-CA", "\u00a4#,##0.00", "#,##0.###", "#,##0%", 45, "a.m.", "p.m.", "EEEE, MMMM d, y", "MMMM d, y", "MMM d, y", "y-MM-dd", "h:mm:ss\u202fa zzzz", "h:mm:ss\u202fa z", "h:mm:ss\u202fa", "h:mm\u202fa", "y-MM-dd, h:mm\u202fa" }, { "de", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0\u00a0%", 45, "AM", "PM", "EEEE, d. MMMM y", "d. MMMM y", "dd.MM.y", "dd.MM.yy", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "dd.MM.yy, HH:mm" }, { "de-DE", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0\u00a0%", 45, "AM", "PM", "EEEE, d. MMMM y", "d. MMMM y", "dd.MM.y", "dd.MM.yy", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "dd.MM.yy, HH:mm" }, { "fr", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0\u00a0%", 45, "AM", "PM", "EEEE d MMMM y", "d MMMM y", "d MMM y", "dd/MM/y", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "dd/MM/y HH:mm" }, { "fr-FR", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0\u00a0%", 45, "AM", "PM", "EEEE d MMMM y", "d MMMM y", "d MMM y", "dd/MM/y", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "dd/MM/y HH:mm" }, { "ja", "\u00a4#,##0.00", "#,##0.###", "#,##0%", 45, "\u5348\u524d", "\u5348\u5f8c", "y\u5e74M\u6708d\u65e5EEEE", "y\u5e74M\u6