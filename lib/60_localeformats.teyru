package teyru

/* The format patterns each carried locale uses, and the one place they are
   written down.

   A pattern is locale data: the JDK's German long date is "d. MMMM y" and its
   Japanese one is "y\\u5e74M\\u6708d\\u65e5", so getDateInstance(LONG, locale)
   cannot be one string with the locale's month names substituted -- it has to
   be the locale's own pattern. These were read out of OpenJDK 21.0.11+10 with
   ((SimpleDateFormat) DateFormat.getDateInstance(style, locale)).toPattern()
   and the currency one with
   ((DecimalFormat) NumberFormat.getCurrencyInstance(locale)).toPattern().

   Row shape: {tag, currencyPattern, dateFull, dateLong, dateMedium, dateShort,
   timeShort, dateTimeShort}. The currency pattern carries the NBSP the JDK puts
   between a number and its symbol in de/fr/es/it/ru, and the missing fraction
   digits of JPY ("\\u00a4#,##0"), which is why it is a pattern rather than a flag.

   How it is verified: tests/programs/t326_locale.teyru formats the same
   instants and numbers as its .java.ref and the .expected is the JDK's output. */
final class LocaleFormats {
  /* dateSymbols answers the language's row from DateSymbols, which is where the
     month and weekday names live; a language not carried answers the ROOT row,
     which is English. */
  static Object[] dateSymbols(Locale locale) {
    String lang = locale.language.length() == 0 ? "en" : locale.language
    for (int i = 0 : i < DateSymbols.ROWS.length : i++) {
      if (DateSymbols.ROWS[i][0].equals(lang)) {
        return DateSymbols.ROWS[i]
      }
    }
    return DateSymbols.ROWS[0]
  }

  private static Object[] row(Locale locale) {
    String tag = locale.toLanguageTag()
    for (int i = 0 : i < ROWS.length : i++) {
      if (ROWS[i][0].equals(tag)) {
        return ROWS[i]
      }
    }
    String lang = locale.language
    if (lang.length() > 0) {
      for (int i = 0 : i < ROWS.length : i++) {
        if (ROWS[i][0].equals(lang)) {
          return ROWS[i]
        }
      }
    }
    return ROWS[0]
  }

  static String currencyPattern(Locale locale) {
    return (String) row(locale)[1]
  }

  /* style is DateFormat's FULL/LONG/MEDIUM/SHORT, which are 0..3. */
  static String datePattern(Locale locale, int style) {
    if (style < 0 || style > 3) {
      throw new IllegalArgumentException("Illegal date style: " + style)
    }
    Object[] r = row(locale)
    return (String) r[2 + style]
  }

  /* The table carries only SHORT times; the other three styles use what the
     library used before there was a table, because a locale's long time differs
     mostly in the zone name and no caller in this library asks for one. */
  static String timePattern(Locale locale, int style) {
    if (style == DateFormat.SHORT) {
      return (String) row(locale)[6]
    }
    return DateFormat.timeStylePattern(style)
  }

  static String dateTimeShortPattern(Locale locale) {
    return (String) row(locale)[7]
  }

  static final Object[][] ROWS = {
    { "", "\u00a4\u00a0#,##0.00", "y MMMM d, EEEE", "y MMMM d", "y MMM d", "y-MM-dd", "HH:mm", "y-MM-dd HH:mm" }, { "en", "\u00a4#,##0.00", "EEEE, MMMM d, y", "MMMM d, y", "MMM d, y", "M/d/yy", "h:mm\u202fa", "M/d/yy, h:mm\u202fa" }, { "en-US", "\u00a4#,##0.00", "EEEE, MMMM d, y", "MMMM d, y", "MMM d, y", "M/d/yy", "h:mm\u202fa", "M/d/yy, h:mm\u202fa" }, { "en-GB", "\u00a4#,##0.00", "EEEE, d MMMM y", "d MMMM y", "d MMM y", "dd/MM/y", "HH:mm", "dd/MM/y, HH:mm" }, { "en-CA", "\u00a4#,##0.00", "EEEE, MMMM d, y", "MMMM d, y", "MMM d, y", "y-MM-dd", "h:mm\u202fa", "y-MM-dd, h:mm\u202fa" }, { "de", "#,##0.00\u00a0\u00a4", "EEEE, d. MMMM y", "d. MMMM y", "dd.MM.y", "dd.MM.yy", "HH:mm", "dd.MM.yy, HH:mm" }, { "de-DE", "#,##0.00\u00a0\u00a4", "EEEE, d. MMMM y", "d. MMMM y", "dd.MM.y", "dd.MM.yy", "HH:mm", "dd.MM.yy, HH:mm" }, { "fr", "#,##0.00\u00a0\u00a4", "EEEE d MMMM y", "d MMMM y", "d MMM y", "dd/MM/y", "HH:mm", "dd/MM/y HH:mm" }, { "fr-FR", "#,##0.00\u00a0\u00a4", "EEEE d MMMM y", "d MMMM y", "d MMM y", "dd/MM/y", "HH:mm", "dd/MM/y HH:mm" }, { "ja", "\u00a4#,##0.00", "y\u5e74M\u6708d\u65e5EEEE", "y\u5e74M\u6708d\u65e5", "y/MM/dd", "y/MM/dd", "H:mm", "y/MM/dd H:mm" }, { "ja-JP", "\u00a4#,##0", "y\u5e74M\u6708d\u65e5EEEE", "y\u5e74M\u6708d\u65e5", "y/MM/dd", "y/MM/dd", "H:mm", "y/MM/dd H:mm" }, { "zh", "\u00a4#,##0.00", "y\u5e74M\u6708d\u65e5EEEE", "y\u5e74M\u6708d\u65e5", "y\u5e74M\u6708d\u65e5", "y/M/d", "HH:mm", "y/M/d HH:mm" }, { "zh-TW", "\u00a4#,##0.00", "y\u5e74M\u6708d\u65e5 EEEE", "y\u5e74M\u6708d\u65e5", "y\u5e74M\u6708d\u65e5", "y/M/d", "ah:mm", "y/M/d ah:mm" }, { "zh-CN", "\u00a4#,##0.00", "y\u5e74M\u6708d\u65e5EEEE", "y\u5e74M\u6708d\u65e5", "y\u5e74M\u6708d\u65e5", "y/M/d", "HH:mm", "y/M/d HH:mm" }, { "es", "#,##0.00\u00a0\u00a4", "EEEE, d 'de' MMMM 'de' y", "d 'de' MMMM 'de' y", "d MMM y", "d/M/yy", "H:mm", "d/M/yy, H:mm" }, { "es-ES", "#,##0.00\u00a0\u00a4", "EEEE, d 'de' MMMM 'de' y", "d 'de' MMMM 'de' y", "d MMM y", "d/M/yy", "H:mm", "d/M/yy, H:mm" }, { "it", "#,##0.00\u00a0\u00a4", "EEEE d MMMM y", "d MMMM y", "d MMM y", "dd/MM/yy", "HH:mm", "dd/MM/yy, HH:mm" }, { "pt", "\u00a4\u00a0#,##0.00", "EEEE, d 'de' MMMM 'de' y", "d 'de' MMMM 'de' y", "d 'de' MMM 'de' y", "dd/MM/y", "HH:mm", "dd/MM/y HH:mm" }, { "pt-BR", "\u00a4\u00a0#,##0.00", "EEEE, d 'de' MMMM 'de' y", "d 'de' MMMM 'de' y", "d 'de' MMM 'de' y", "dd/MM/y", "HH:mm", "dd/MM/y HH:mm" }, { "ru", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM y\u202f'\u0433'.", "d MMMM y\u202f'\u0433'.", "d MMM y\u202f'\u0433'.", "dd.MM.y", "HH:mm", "dd.MM.y, HH:mm" }, { "ru-RU", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM y\u202f'\u0433'.", "d MMMM y\u202f'\u0433'.", "d MMM y\u202f'\u0433'.", "dd.MM.y", "HH:mm", "dd.MM.y, HH:mm" }, { "ko", "\u00a4#,##0.00", "y\ub144 M\uc6d4 d\uc77c EEEE", "y\ub144 M\uc6d4 d\uc77c", "y. M. d.", "yy. M. d.", "a h:mm", "yy. M. d. a h:mm" }, { "ko-KR", "\u00a4#,##0", "y\ub144 M\uc6d4 d\uc77c EEEE", "y\ub144 M\uc6d4 d\uc77c", "y. M. d.", "yy. M. d.", "a h:mm", "yy. M. d. a h:mm" }, { "ar", "\u200f#,##0.00\u00a0\u00a4", "EEEE\u060c d MMMM y", "d MMMM y", "dd\u200f/MM\u200f/y", "d\u200f/M\u200f/y", "h:mm a", "d\u200f/M\u200f/y\u060c h:mm a" }, { "nl", "\u00a4\u00a0#,##0.00;\u00a4\u00a0-#,##0.00", "EEEE d MMMM y", "d MMMM y", "d MMM y", "dd-MM-y", "HH:mm", "dd-MM-y HH:mm" }, { "pl", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM y", "d MMMM y", "d MMM y", "d.MM.y", "HH:mm", "d.MM.y, HH:mm" }, { "sv", "#,##0.00\u00a0\u00a4", "EEEE d MMMM y", "d MMMM y", "d MMM y", "y-MM-dd", "HH:mm", "y-MM-dd HH:mm" }, { "tr", "\u00a4#,##0.00", "d MMMM y EEEE", "d MMMM y", "d MMM y", "d.MM.y", "HH:mm", "d.MM.y HH:mm" }, { "uk", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM y\u202f'\u0440'.", "d MMMM y\u202f'\u0440'.", "d MMM y\u202f'\u0440'.", "dd.MM.yy", "HH:mm", "dd.MM.yy, HH:mm" }, { "cs", "#,##0.00\u00a0\u00a4", "EEEE d. MMMM y", "d. MMMM y", "d. M. y", "dd.MM.yy", "H:mm", "dd.MM.yy H:mm" }, { "el", "#,##0.00\u00a0\u00a4", "EEEE d MMMM y", "d MMMM y", "d MMM y", "d/M/yy", "h:mm\u202fa", "d/M/yy, h:mm\u202fa" }, { "he", "\u200f#,##0.00\u00a0\u200f\u00a4;\u200f-#,##0.00\u00a0\u200f\u00a4", "EEEE, d \u05d1MMMM y", "d \u05d1MMMM y", "d \u05d1MMM y", "d.M.y", "H:mm", "d.M.y, H:mm" }, { "th", "\u00a4#,##0.00", "EEEE\u0e17\u0e35\u0e48 d MMMM G y", "d MMMM G y", "d MMM y", "d/M/yy", "HH:mm", "d/M/yy HH:mm" }, { "vi", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM, y", "d MMMM, y", "d MMM, y", "dd/MM/y", "HH:mm", "HH:mm, dd/MM/y" }, { "id", "\u00a4#,##0.00", "EEEE, dd MMMM y", "d MMMM y", "d MMM y", "dd/MM/yy", "HH.mm", "dd/MM/yy HH.mm" }, { "fi", "#,##0.00\u00a0\u00a4", "EEEE d. MMMM y", "d. MMMM y", "d.M.y", "d.M.y", "H.mm", "d.M.y H.mm" }, { "da", "#,##0.00\u00a0\u00a4", "EEEE 'den' d. MMMM y", "d. MMMM y", "d. MMM y", "dd.MM.y", "HH.mm", "dd.MM.y HH.mm" }, { "no", "\u00a4\u00a0#,##0.00;\u00a4\u00a0-#,##0.00", "EEEE d. MMMM y", "d. MMMM y", "d. MMM y", "dd.MM.y", "HH:mm", "dd.MM.y, HH:mm" }, { "hu", "#,##0.00\u00a0\u00a4", "y. MMMM d., EEEE", "y. MMMM d.", "y. MMM d.", "y. MM. dd.", "H:mm", "y. MM. dd. H:mm" }, { "ro", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM y", "d MMMM y", "d MMM y", "dd.MM.y", "HH:mm", "dd.MM.y, HH:mm" }, { "bg", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM y\u202f'\u0433'.", "d MMMM y\u202f'\u0433'.", "d.MM.y\u202f'\u0433'.", "d.MM.yy\u202f'\u0433'.", "H:mm '\u0447'.", "d.MM.yy\u202f'\u0433'., H:mm '\u0447'." }, { "hr", "#,##0.00\u00a0\u00a4", "EEEE, d. MMMM y.", "d. MMMM y.", "d. MMM y.", "dd. MM. y.", "HH:mm", "dd. MM. y. HH:mm" }, { "sk", "#,##0.00\u00a0\u00a4", "EEEE d. MMMM y", "d. MMMM y", "d. M. y", "d. M. y", "H:mm", "d. M. y H:mm" }, { "sl", "#,##0.00\u00a0\u00a4", "EEEE, d. MMMM y", "d. MMMM y", "d. MMM y", "d. MM. yy", "HH:mm", "d. MM. yy, HH:mm" }, { "et", "#,##0.00\u00a0\u00a4", "EEEE, d. MMMM y", "d. MMMM y", "d. MMM y", "dd.MM.yy", "HH:mm", "dd.MM.yy HH:mm" }, { "lv", "#,##0.00\u00a0\u00a4", "EEEE, y. 'gada' d. MMMM", "y. 'gada' d. MMMM", "y. 'gada' d. MMM", "dd.MM.yy", "HH:mm", "dd.MM.yy HH:mm" }, { "ca", "#,##0.00\u00a0\u00a4", "EEEE, d MMMM 'de' y", "d MMMM 'de' y", "d MMM y", "d/M/yy", "H:mm", "d/M/yy H:mm" },
  }
}
