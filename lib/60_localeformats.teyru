, "d. M. y", "H:mm:ss zzzz", "H:mm:ss z", "H:mm:ss", "H:mm", "d. M. y H:mm" }, { "sl", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0\u00a0%", 8722, "dop.", "pop.", "EEEE, d. MMMM y", "d. MMMM y", "d. MMM y", "d. MM. yy", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "d. MM. yy, HH:mm" }, { "et", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0%", 8722, "AM", "PM", "EEEE, d. MMMM y", "d. MMMM y", "d. MMM y", "dd.MM.yy", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "dd.MM.yy HH:mm" }, { "lv", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0%", 45, "priek\u0161pusdien\u0101", "p\u0113cpusdien\u0101", "EEEE, y. 'gada' d. MMMM", "y. 'gada' d. MMMM", "y. 'gada' d. MMM", "dd.MM.yy", "HH:mm:ss zzzz", "HH:mm:ss z", "HH:mm:ss", "HH:mm", "dd.MM.yy HH:mm" }, { "ca", "#,##0.00\u00a0\u00a4", "#,##0.###", "#,##0\u00a0%", 45, "a.\u00a0m.", "p.\u00a0m.", "EEEE, d MMMM 'de' y", "d MMMM 'de' y", "d MMM y", "d/M/yy", "H:mm:ss (zzzz)", "H:mm:ss z", "H:mm:ss", "H:mm", "d/M/yy H:mm" },
