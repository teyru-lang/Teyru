package teyru

/* Sessions give a run of requests one identity.
 *
 * The first time a handler asks for a session the server hands the client a
 * cookie and remembers the id; every request after that carries the cookie back
 * and finds the same attributes. This is what javax.servlet.http.HttpSession
 * does, and what Spring's `session` scope is built on.
 *
 * A handler asks the request for it, and the server puts the cookie on the
 * answer on the way out -- the handler's own response is built later than its
 * call, so setting the cookie there would be a race against itself:
 *
 *     public String login(HttpRequest req) {
 *       HttpSession s = Sessions.of(req)
 *       s.setAttribute("user", req.param("name"))
 *       return "hello " + s.getString("user")
 *     }
 *
 * The store lives in the process, so a session is one server's session: with
 * two processes behind a load balancer the requests must come back to the one
 * that made the session (Spring calls the shared-store version "sticky
 * sessions" and it needs a store this runtime does not have yet).
 *
 * The id is 128 bits from java.util.Random, which is seeded from the clock and
 * is not a cryptographic source; it is unpredictable enough for a session on a
 * server like this one, and a public deployment should replace it with a real
 * random source (the runtime has no /dev/urandom binding yet). */

class HttpSession {
  public String id = ""
  public long creationTime = 0
  public long lastAccessTime = 0
  // maxInactiveInterval is how long the session may go untouched, in seconds,
  // as the servlet's setMaxInactiveInterval means it: 0 or less is never. What
  // a session actually gets is this when it was set on the session, and the
  // store's default otherwise.
  public int maxInactiveInterval = 0
  // fresh is public because Sessions.of sets it on the session it just made.
  public boolean fresh = false
  private Map<String, Object> attributes = new LinkedHashMap<String, Object>()
  private List<String> names = new ArrayList<String>()

  public String getId() {
    return id
  }

  // isNew answers true for the request that created the session, which is the
  // one the cookie went out on. It is the servlet's name for the same question.
  public boolean isNew() {
    return fresh
  }

  public boolean hasAttribute(String name) {
    return attributes.containsKey(name)
  }

  public Object getAttribute(String name) {
    return attributes.get(name)
  }

  public String getString(String name) {
    Object v = attributes.get(name)
    if (v == null) {
      return ""
    }
    return v.toString()
  }

  public void setAttribute(String name, Object value) {
    if (attributes.containsKey(name) == false) {
      names.add(name)
    }
    attributes.put(name, value)
  }

  public void removeAttribute(String name) {
    if (attributes.containsKey(name)) {
      attributes.remove(name)
      names.remove(name)
    }
  }

  // attributeNames is in the order the attributes were first set, which is the
  // order a page listing them should use.
  public List<String> attributeNames() {
    return new ArrayList<String>(names)
  }

  public long getCreationTime() {
    return creationTime
  }

  public long getLastAccessedTime() {
    return lastAccessTime
  }

  public void touch() {
    lastAccessTime = System.currentTimeMillis()
  }

  public int getMaxInactiveInterval() {
    return maxInactiveInterval
  }

  public void setMaxInactiveInterval(int seconds) {
    maxInactiveInterval = seconds
  }

  // isExpired answers whether the session has been idle longer than it is
  // allowed to be. The interval that applies is the session's own when it has
  // one, and the store's default otherwise, which is how a container lets a
  // program set a timeout for everything and shorten it for one session.
  public boolean isExpired(long now) {
    int limit = maxInactiveInterval
    if (limit <= 0) {
      limit = Sessions.defaultTimeout
    }
    if (limit <= 0) {
      return false
    }
    return now - lastAccessTime > (long)limit * 1000L
  }

  // invalidate forgets the attributes and takes the id out of the store, so the
  // next request that carries the old cookie is given a new session. The
  // client's cookie is not cleared here because a session has no answer to
  // write on; Sessions.of will not recognise the id, which is what logging out
  // needs.
  public void invalidate() {
    attributes.clear()
    names.clear()
    Sessions.forget(id)
  }
}

class Sessions {
  public static final String COOKIE_NAME = "TEYRUSSESSIONID"

  private static Map<String, HttpSession> store = new LinkedHashMap<String, HttpSession>()
  // order is the ids in the order they were created, which is the order a sweep
  // walks them in: a session that is never touched again is only found by the
  // sweep, so the sweep has to exist.
  private static List<String> order = new ArrayList<String>()
  private static Random random = new Random()
  private static int defaultTimeout = 0
  // sweepAt is where the next sweep picks up. Every request checks a few
  // sessions rather than every request checking all of them, which is how a
  // store with no background thread can still bound itself: the work is spread
  // over the traffic instead of done by a reaper.
  private static int sweepAt = 0
  private static final int SWEEP_PER_USE = 8

  // of answers the session this request belongs to, making one when the request
  // carries no usable id. The new session's cookie is stamped on the answer by
  // the server (HttpServer.send), which is where the response finally exists.
  public static HttpSession of(HttpRequest req) {
    HttpSession existing = Sessions.find(req)
    if (existing != null) {
      // isNew is true for the request that created the session and no other,
      // so it is cleared here rather than when the next one finds it: a handler
      // that asks twice in one request still made it.
      existing.fresh = false
      existing.touch()
      return existing
    }
    // A session this same request already started, which is the answer a second
    // call in one request has to get. Without this the second call makes a
    // second session: the request has no cookie naming the first one -- the
    // client is not sent it until the answer is written -- so find() above
    // cannot see it, and the first session is left in the store with nothing
    // pointing at it. A handler that asks twice in a request is not unusual,
    // and one entry per request in a store that is only swept when a default
    // timeout is set is a leak that grows with the traffic.
    if (req.pendingSession.length() > 0) {
      HttpSession started = store.get(req.pendingSession)
      if (started != null) {
        return started
      }
    }
    HttpSession made = new HttpSession()
    made.id = Sessions.newId()
    made.creationTime = System.currentTimeMillis()
    made.lastAccessTime = made.creationTime
    made.fresh = true
    store.put(made.id, made)
    order.add(made.id)
    Sessions.sweepSome()
    req.pendingSession = made.id
    return made
  }

  // find answers the session this request carries, or null. It is what a
  // handler that must not create one uses, the way a login page reads an
  // existing session without starting another.
  public static HttpSession find(HttpRequest req) {
    Sessions.sweepSome()
    String id = req.cookie(Sessions.COOKIE_NAME)
    if (id.isEmpty()) {
      return null
    }
    HttpSession s = store.get(id)
    if (s == null) {
      return null
    }
    // An expired session is not a session: the cookie the client is still
    // holding names nothing, and the next request that wants one is given a new
    // one, which is what a container does when a session times out.
    if (s.isExpired(System.currentTimeMillis())) {
      Sessions.forget(id)
      return null
    }
    s.touch()
    return s
  }

  // setTimeout is the store's default inactivity limit in seconds, for sessions
  // that do not set their own. 0 means no limit, which is the default: a program
  // that wants its sessions to expire has to say so.
  public static void setTimeout(int seconds) {
    defaultTimeout = seconds
  }

  public static int getTimeout() {
    return defaultTimeout
  }

  // prune drops every session that has expired and answers how many it dropped.
  // It is the whole store at once, for a test or for a program that has a quiet
  // moment; the sweeps that happen during requests are what keep a busy server
  // from growing without bound.
  public static int prune() {
    long now = System.currentTimeMillis()
    int dropped = 0
    List<String> keep = new ArrayList<String>()
    for (int i = 0 : i < order.size() : i++) {
      String id = order.get(i)
      HttpSession s = store.get(id)
      if (s != null && s.isExpired(now)) {
        store.remove(id)
        dropped = dropped + 1
      } else {
        keep.add(id)
      }
    }
    order = keep
    sweepAt = 0
    return dropped
  }

  // sweepSome checks the next few sessions and drops the ones that have expired.
  // A store with no background thread cannot look at everything on every
  // request, and it does not have to: each request advances a cursor, so the
  // cost per request is bounded and every session is looked at eventually.
  private static void sweepSome() {
    // A store with no default limit has nothing to sweep for: a session that set
    // its own interval is checked when it is found (find does that exactly) and
    // by prune. Walking the ids here to ask whether any session has one would
    // make every request O(sessions), which is the cost the sweep exists to
    // avoid.
    if (defaultTimeout <= 0) {
      return
    }
    long now = System.currentTimeMillis()
    int checked = 0
    while (checked < SWEEP_PER_USE && order.size() > 0) {
      if (sweepAt >= order.size()) {
        sweepAt = 0
      }
      String id = order.get(sweepAt)
      HttpSession s = store.get(id)
      if (s == null || s.isExpired(now)) {
        store.remove(id)
        order.remove(sweepAt)
      } else {
        sweepAt = sweepAt + 1
      }
      checked = checked + 1
    }
  }

  public static void forget(String id) {
    store.remove(id)
    order.remove(id)
  }

  public static int count() {
    return store.size()
  }

  // clear drops every session. A test calls it between cases; nothing in a
  // running server does.
  public static void clear() {
    store.clear()
    order.clear()
    sweepAt = 0
  }

  private static String newId() {
    return Long.toHexString(random.nextLong()) + Long.toHexString(random.nextLong())
  }

  // cookieHeader is the Set-Cookie line for a session id, which the server
  // writes when a handler started one during this request.
  public static String cookieHeader(String id) {
    return Sessions.COOKIE_NAME + "=" + id + "; Path=/; HttpOnly"
  }
}
