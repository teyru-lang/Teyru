package teyru

/* String is the one class in java.lang whose Java surface is large enough that
   the shape of its implementation matters. The rule followed here is the one
   the rest of the prelude follows: a method that is a loop over bytes is C
   (native, in tyrt.c), a method that is a decision about arguments is Teyru.
   So substring, indexOf and the case conversions are native, while everything
   that has to raise a Java-shaped exception -- the bounds checks, the parse
   failures, the regex guard -- stays on this side of the boundary, where the
   exception classes exist.

   A string is stored as WTF-8 and carries both of its lengths: the bytes it
   takes and the UTF-16 code units they spell. WTF-8 is what lets a string hold
   a surrogate with no partner -- "\uD800" is a string Java has -- and a high
   surrogate followed by its low one is stored as the one four-byte sequence
   they are as a code point. The constructors that take bytes decode them the
   way the JDK's UTF-8 decoder does, replacing anything ill-formed with U+FFFD,
   and getBytes encodes the way its UTF-8 encoder does. */
class String extends Object implements Comparable<String> {
  public native String(String original)
  public native String(byte[] bytes)
  public native String(byte[] bytes, int offset, int length)
  public native int length()
  public native boolean isEmpty()
  public native boolean isBlank()
  public native char charAt(int index)
  public native boolean equals(Object o)
  public native boolean equalsIgnoreCase(String s)
  public native int hashCode()
  public native int compareTo(String s)
  public native int compareToIgnoreCase(String s)
  public native boolean startsWith(String prefix)
  public native boolean startsWith(String prefix, int offset)
  public native boolean endsWith(String suffix)
  public native boolean contains(String s)
  public native int indexOf(int ch)
  public native int indexOf(int ch, int from)
  public native int indexOf(String s)
  public native int indexOf(String s, int from)
  public native int lastIndexOf(int ch)
  public native int lastIndexOf(int ch, int from)
  public native int lastIndexOf(String s)
  public native int lastIndexOf(String s, int from)
  public native String substring(int from)
  public native String substring(int from, int to)
  public native String concat(String s)
  public native String repeat(int count)
  public native String strip()
  public native String stripLeading()
  public native String stripTrailing()
  public native String trim()
  public native String toUpperCase()
  public native String toLowerCase()
  public native char[] toCharArray()
  public native byte[] getBytes()
  public native String intern()
  public native String toString()
  public native String replace(char old, char now)
  public native String replace(String old, String now)
  /* Java's five regex methods. These were natively implemented over a literal
     pattern until lib/21 gave the language an engine; now they are what Java
     says they are -- Pattern.compile(re) and a Matcher call. `matches` is
     anchored at both ends, replaceAll/replaceFirst are not, which is exactly
     what Matcher does; the only thing left here is Java's handling of a
     trailing empty field in split, which the Matcher overloads cannot express
     because they work on a match rather than on a partition. */
  public String replaceAll(String re, String rep) {
    return Pattern.compile(re).matcher(this).replaceAll(rep)
  }
  public String replaceFirst(String re, String rep) {
    return Pattern.compile(re).matcher(this).replaceFirst(rep)
  }
  public boolean matches(String re) {
    return Pattern.compile(re).matcher(this).matches()
  }
  public String[] split(String re) {
    return split(re, 0)
  }
  public String[] split(String re, int limit) {
    return Pattern.compile(re).split(this, limit)
  }

  /* Java's String.lines: the lines of this string as a stream. A line is a
     sequence of characters up to a terminator (\n, \r\n or \r) or to the end
     of the string, and the terminator is not part of it -- so a string that
     ends in one has no empty line after it, and an empty string has no lines at
     all. Both come out of the split's own rules: a limit of zero drops the
     trailing empty fields, and the empty string is the one case that rule does
     not cover. */
  public Stream<String> lines() {
    List<String> out = new ArrayList<String>()
    int n = length()
    int start = 0
    while (start < n) {
      int i = start
      int at = -1
      int skip = 1
      while (i < n) {
        char c = charAt(i)
        if (c == '\n') {
          at = i
          break
        }
        if (c == '\r') {
          at = i
          if (i + 1 < n && charAt(i + 1) == '\n') {
            skip = 2
          }
          break
        }
        i++
      }
      if (at < 0) {
        out.add(substring(start, n))
        break
      }
      out.add(substring(start, at))
      start = at + skip
    }
    return Streams.of(out)
  }

  public static native String valueOf(Object v)
  public static native String valueOf(char[] v)
  public static native String valueOf(char[] v, int offset, int count)
  public static native String valueOf(boolean v)
  public static native String valueOf(char c)
  public static native String valueOf(int v)
  public static native String valueOf(long v)
  public static native String valueOf(float v)
  public static native String valueOf(double v)
  public static String copyValueOf(char[] v) {
    return valueOf(v)
  }
  public static String copyValueOf(char[] v, int offset, int count) {
    return valueOf(v, offset, count)
  }

  /* format is the one place the prelude needs a native method that takes a
     vararg array. Varargs are packed at the call site (packVarargs) but a
     native call passes the arguments through untouched, so a `native` method
     declared `Object...` would receive each argument as a separate parameter
     and the C helper could not see the count. The wrapper below is therefore a
     normal method -- whose body does see the packed array -- delegating to a
     private native that takes the array. */
  public static String format(String fmt, Object... args) {
    if (fmt == null) {
      throw new NullPointerException()
    }
    return formatArgs(fmt, args)
  }
  private static native String formatArgs(String fmt, Object[] args)

  /* join is pure Teyru: it is a loop over an array, and the loop is clearer
     here than as a C helper. The null argument checks are Java's. */
  public static String join(String delim, String... elements) {
    if (delim == null) {
      throw new NullPointerException()
    }
    if (elements == null) {
      throw new NullPointerException()
    }
    if (elements.length == 0) {
      return ""
    }
    StringBuilder sb = new StringBuilder()
    for (var i = 0 : i < elements.length : i++) {
      if (i > 0) {
        sb.append(delim)
      }
      sb.append(elements[i])
    }
    return sb.toString()
  }
}

/* StringBuilder is the mutable byte buffer behind string building and
   String.format. It is allocated by the runtime (ty_sb_new, wired through
   specialNew) rather than by generated code, so every native below casts its
   receiver to the runtime's tySB.

   StringBuffer is the same class under its old, synchronized name: Java has
   both, they differ only in thread safety, and Teyru has no threads, so the
   two share one implementation and one C helper set. Programs that mention
   StringBuffer get Java's API and Java's semantics; programs that mention
   StringBuilder get the faster name. */
class StringBuilder extends Object {
  /* The two constructors that take an argument. `new StringBuilder()` is
     allocated by the runtime (specialNew maps it to ty_sb_new, which is what
     gives a builder its buffer); a `new` with an argument is an ordinary
     allocation followed by this constructor, so the buffer is created by
     init -- before anything can append to it -- and the capacity Java takes
     is only a hint. append and insert on a builder are the same methods
     either way, so an object built by either path behaves identically. */
  /* the no-argument form is what specialNew allocates, so this body is empty:
     declaring it only keeps the class constructible now that it has others. */
  public StringBuilder() {
  }
  public StringBuilder(int capacity) {
    init(capacity)
  }
  public StringBuilder(String s) {
    if (s == null) {
      throw new NullPointerException()
    }
    init(s.length())
    appendRaw(s)
  }
  private native void init(int capacity)
  /* append(String) and insert(int, String) take null for the four characters
     "null", as Java's do. The runtime's ty_sb_append_str writes nothing for a
     null, which is the behaviour the print helpers want and the behaviour the
     builder must not have, so the substitution happens here, in front of a
     private native that is never handed a null. */
  public StringBuilder append(String s) {
    return appendRaw(s == null ? "null" : s)
  }
  private native StringBuilder appendRaw(String s)
  public native StringBuilder append(Object o)
  public native StringBuilder append(int v)
  public native StringBuilder append(long v)
  public native StringBuilder append(float v)
  public native StringBuilder append(double v)
  public native StringBuilder append(boolean v)
  public native StringBuilder append(char c)
  public native StringBuilder append(char[] chars)
  public StringBuilder insert(int at, String s) {
    return insertRaw(at, s == null ? "null" : s)
  }
  private native StringBuilder insertRaw(int at, String s)
  public native StringBuilder insert(int at, Object o)
  public native StringBuilder insert(int at, int v)
  public native StringBuilder insert(int at, long v)
  public native StringBuilder insert(int at, float v)
  public native StringBuilder insert(int at, double v)
  public native StringBuilder insert(int at, boolean v)
  public native StringBuilder insert(int at, char c)
  public native StringBuilder insert(int at, char[] chars)
  public native StringBuilder delete(int from, int to)
  public native StringBuilder deleteCharAt(int at)
  public StringBuilder replace(int from, int to, String s) {
    return replaceRaw(from, to, s == null ? "null" : s)
  }
  private native StringBuilder replaceRaw(int from, int to, String s)
  public native StringBuilder reverse()
  public native char charAt(int at)
  public native void setCharAt(int at, char c)
  public native int length()
  public native boolean isEmpty()
  public native int capacity()
  public native void ensureCapacity(int min)
  public native void setLength(int n)
  public native String substring(int from)
  public native String substring(int from, int to)
  public native int indexOf(String s)
  public native int indexOf(String s, int from)
  public native int lastIndexOf(String s)
  public native String toString()
}

class StringBuffer extends Object {
  /* StringBuilder is one of the classes the compiler aliases to a runtime
     struct (sema marks it Special = "sb", and `C_teyru_StringBuilder` becomes
     `tySB`), but only StringBuilder is marked: StringBuffer's C type is a
     struct of its own. That is invisible while every StringBuffer comes from
     ty_sb_new -- one pointer, cast to tySB by the natives -- and stops being
     invisible the moment a constructor has to allocate one, because the
     allocation is then `sizeof` the generated struct. These three fields are
     what makes that struct the same size and shape as tySB (obj, len, cap,
     buf), so a StringBuffer built by a constructor and one built by the
     runtime are the same object. They are private, never read by Teyru code,
     and buf is a long rather than an Object on purpose: as a reference the
     collector would follow it into the builder's malloc'd bytes. */
  private long len
  private long cap
  private long buf
  /* the same three constructors as StringBuilder, for the same reason */
  public StringBuffer() {
  }
  public StringBuffer(int capacity) {
    init(capacity)
  }
  public StringBuffer(String s) {
    if (s == null) {
      throw new NullPointerException()
    }
    init(s.length())
    append(s)
  }
  private native void init(int capacity)
  /* append(String) takes null for "null" here too -- the same wrapper around
     the same native StringBuilder uses, so the two names really do share one
     implementation and not just one set of C helpers. */
  public StringBuffer append(String s) {
    return appendRaw(s == null ? "null" : s)
  }
  private native StringBuffer appendRaw(String s)
  public native StringBuffer append(Object o)
  public native StringBuffer append(int v)
  public native StringBuffer append(long v)
  public native StringBuffer append(float v)
  public native StringBuffer append(double v)
  public native StringBuffer append(boolean v)
  public native StringBuffer append(char c)
  public native StringBuffer append(char[] chars)
  public StringBuffer insert(int at, String s) {
    return insertRaw(at, s == null ? "null" : s)
  }
  private native StringBuffer insertRaw(int at, String s)
  public native StringBuffer insert(int at, Object o)
  public native StringBuffer insert(int at, int v)
  public native StringBuffer insert(int at, long v)
  public native StringBuffer insert(int at, float v)
  public native StringBuffer insert(int at, double v)
  public native StringBuffer insert(int at, boolean v)
  public native StringBuffer insert(int at, char c)
  public native StringBuffer insert(int at, char[] chars)
  public native StringBuffer delete(int from, int to)
  public native StringBuffer deleteCharAt(int at)
  public StringBuffer replace(int from, int to, String s) {
    return replaceRaw(from, to, s == null ? "null" : s)
  }
  private native StringBuffer replaceRaw(int from, int to, String s)
  public native StringBuffer reverse()
  public native char charAt(int at)
  public native void setCharAt(int at, char c)
  public native int length()
  public native boolean isEmpty()
  public native int capacity()
  public native void ensureCapacity(int min)
  public native void setLength(int n)
  public native String substring(int from)
  public native String substring(int from, int to)
  public native int indexOf(String s)
  public native int indexOf(String s, int from)
  public native int lastIndexOf(String s)
  public native String toString()
}
