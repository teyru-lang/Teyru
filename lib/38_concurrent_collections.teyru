package teyru

/* The rest of java.util.concurrent this runtime can carry honestly: the
 * synchronizer CountDownLatch, the atomic wrappers, and the concurrent map.
 *
 * All three are built on the monitor `synchronized` takes and on
 * Object.wait/notifyAll, and on nothing else. The runtime has no hardware
 * atomics, so there is no lock-free anything here, and each class says so in
 * its own comment: a reader who assumes AtomicInteger.compareAndSet is a CAS,
 * or that ConcurrentHashMap is striped and lock-free under a heavy put load,
 * would reason about contention the wrong way. What is true is that every one
 * of them is safe for several threads to use at once, and that each individual
 * call is atomic -- which is what makes a counter that two threads increment
 * end up with exactly the right number, and it is what the tests check.
 *
 * The one waiting class here, CountDownLatch, waits the way everything in
 * 37_executor.teyru waits: a thread that has to block is inside Object.wait on
 * the latch's own monitor, with the count it is waiting for guarded by that
 * same monitor, and the countDown that takes the count to zero releases every
 * waiter with one notifyAll. Several threads waiting on one object is the
 * ordinary shape of a synchronizer, and the runtime carries it.
 *
 * Absent, and deliberately not declared: TimeUnit (every duration here is
 * milliseconds, as in Thread.sleep), CyclicBarrier, Semaphore, Phaser,
 * Exchanger, and the atomic field updaters. CountDownLatch.await waits with
 * Object.wait, so an interrupt ends it with InterruptedException -- this
 * compiler does not check checked exceptions, so the method declares no throws
 * clause for it, as in the rest of this library. */

/* Java's CountDownLatch: a gate that opens when the count reaches zero.
 *
 * The count is one object's monitor. countDown and the two awaits all take that
 * monitor, so a countDown that empties the latch cannot slip between an
 * awaiter's test of the count and its decision to wait: the awaiter holds the
 * monitor while it decides, and a thread that arrives after the latch opened is
 * answered without waiting at all. An awaiter waits on that same monitor,
 * which it gives up for the wait, and countDown wakes all of them with a
 * notifyAll: any number of threads may await one latch, and each of them wakes
 * because the count reached zero, not because a notification happened to reach
 * one waiter. */
class CountDownLatch {
  /* Written only under this object's monitor. */
  private int count

  public CountDownLatch(int count) {
    if (count < 0) {
      throw new IllegalArgumentException("count must not be negative: " + count)
    }
    this.count = count
  }

  /* Take one off. Every thread that reaches the latch does this once; the
     thread that takes the last one wakes everybody waiting. Counting down past
     zero is a no-op, as in Java, so a task that counts down twice does not open
     the gate early. */
  public void countDown() {
    synchronized (this) {
      if (this.count > 0) {
        this.count = this.count - 1
        if (this.count == 0) {
          /* The latch is open, and everybody waiting on it is inside this
             monitor's wait. */
          this.notifyAll()
        }
      }
    }
  }

  /* Wait until the count reaches zero. The wait is on the latch's own monitor,
     so any number of threads may await the same latch at once, and the count is
     the condition: a countDown that has already emptied it is seen without
     waiting, and one that empties it while this thread waits releases it. */
  public void await() {
    synchronized (this) {
      while (this.count > 0) {
        this.wait(-1L)
      }
    }
  }

  /* Wait up to this many milliseconds. Answers true when the count reached
     zero and false when the time ran out with it still above zero -- Java's
     boolean, and the reason a program can wait on a latch it does not fully
     control without hanging forever. */
  public boolean await(long millis) {
    long deadline = System.nanoTime() + millis * 1000000L
    synchronized (this) {
      while (this.count > 0) {
        long left = deadline - System.nanoTime()
        if (left <= 0) {
          /* the time is up with the count still above zero: this waiter answers
             false, and it is not on any list to be taken off -- the latch holds
             nothing but its count */
          return false
        }
        long millisLeft = left / 1000000L
        if (millisLeft <= 0) {
          /* under a millisecond left, and wait counts in milliseconds: spend it
             as one, and let the loop answer */
          millisLeft = 1
        }
        /* One wait for as long as the caller has left: a countDown that empties
           the latch releases it at once, and the deadline is the caller's. */
        this.wait(millisLeft)
      }
      return true
    }
  }

  /* How many countDowns are still outstanding. Java's answer is a long; this
     one counts an int, which is what Long.MAX_VALUE counts worth of threads
     would never reach. */
  public long getCount() {
    synchronized (this) {
      return this.count
    }
  }
}

/* An int that several threads may update without losing an update.
 *
 * THIS IS A MONITOR, NOT A CAS. Every method below is synchronized on the
 * object, so each call is atomic with respect to every other call -- which is
 * all AtomicInteger promises, and all the tests need -- but there is no
 * hardware compare-and-swap underneath it, because the runtime has none. Two
 * threads hammering this counter serialize on one monitor; in Java they would
 * spin on a cache line instead. The answers are the same; the scaling is not,
 * and a program that would be lock-free in Java is not lock-free here.
 *
 * The one place that shows: incrementAndGet is one monitor acquisition, not a
 * retry loop, so it cannot fail and cannot need retrying -- but it also cannot
 * be composed with another operation the way getAndIncrement followed by
 * compareAndSet could be in Java.
 *
 * Nothing here waits, so nothing here has a condition to be woken for: a
 * monitor that is taken and released, with no waiter on it, is all these need
 * -- and all a monitor has to do for a CAS that is spelled as a critical
 * section. */
class AtomicInteger {
  private int value

  public AtomicInteger() {}

  public AtomicInteger(int initialValue) {
    this.value = initialValue
  }

  public synchronized int get() {
    return this.value
  }

  public synchronized void set(int newValue) {
    this.value = newValue
  }

  public synchronized int getAndSet(int newValue) {
    int old = this.value
    this.value = newValue
    return old
  }

  public synchronized int getAndIncrement() {
    int old = this.value
    this.value = old + 1
    return old
  }

  public synchronized int incrementAndGet() {
    this.value = this.value + 1
    return this.value
  }

  public synchronized int addAndGet(int delta) {
    this.value = this.value + delta
    return this.value
  }

  /* Set the value to update and answer true only if it was expect when the
     monitor was taken -- read, compared and written inside one critical
     section, so no other thread can slip between the comparison and the write.
     That is the promise compareAndSet makes; only the way it is kept differs
     from Java's. */
  public synchronized boolean compareAndSet(int expect, int update) {
    if (this.value != expect) {
      return false
    }
    this.value = update
    return true
  }

  /* Java's AtomicInteger.toString is the value in decimal. */
  public synchronized String toString() {
    return "" + this.value
  }
}

/* A long under the same lock, with the same caveat as AtomicInteger: this is
   a monitor, not a CAS, and it is correct rather than lock-free. */
class AtomicLong {
  private long value

  public AtomicLong() {}

  public AtomicLong(long initialValue) {
    this.value = initialValue
  }

  public synchronized long get() {
    return this.value
  }

  public synchronized void set(long newValue) {
    this.value = newValue
  }

  public synchronized long getAndSet(long newValue) {
    long old = this.value
    this.value = newValue
    return old
  }

  public synchronized long getAndIncrement() {
    long old = this.value
    this.value = old + 1L
    return old
  }

  public synchronized long incrementAndGet() {
    this.value = this.value + 1L
    return this.value
  }

  public synchronized long addAndGet(long delta) {
    this.value = this.value + delta
    return this.value
  }

  public synchronized boolean compareAndSet(long expect, long update) {
    if (this.value != expect) {
      return false
    }
    this.value = update
    return true
  }

  public synchronized String toString() {
    return "" + this.value
  }
}

/* A map several threads may use at once.
 *
 * THIS IS A HashMap BEHIND THE MAP'S MONITOR, NOT A LOCK-STRIPED TABLE. Every
 * method below is synchronized on the map object, so one put excludes every
 * other put and every get -- there is no per-bin locking and no lock-free read
 * path, which is most of why java.util.concurrent.ConcurrentHashMap is fast.
 * What it does give is what Java's gives: no lost puts under concurrency, an
 * exact size, and no ConcurrentModificationException to fear, because nothing
 * modifies the table outside the monitor. It is correct, not scalable.
 *
 * Two divergences from Java's class, both deliberate:
 *
 *   - It does not implement Map<K, V>. Java's implements ConcurrentMap, and
 *     this standard library's Map declares the whole interface -- clear,
 *     putAll, containsValue, keySet, values, entrySet, equals, hashCode -- none
 *     of which is here, because declaring them would mean either implementing
 *     them (fine, but not what this class is for) or declaring methods that do
 *     not exist. A program that wants a Map uses a HashMap, under its own
 *     monitor if threads share it.
 *
 *   - keys() answers an Enumeration over a *snapshot* -- every key copied
 *     under the monitor before the enumeration is handed out -- rather than
 *     Java's weakly consistent iterator over a live table. So this enumeration
 *     is stable: it will not see a put that happens after it was made, and it
 *     will never fail, where Java's may or may not reflect concurrent changes.
 *     The cost is a copy of the keys.
 *
 * Null is rejected as it is in Java's class: a null key or value throws
 * NullPointerException, and the table behind this can hold neither. */
class ConcurrentHashMap<K, V> {
  private HashMap<K, V> map = new HashMap<K, V>()

  /* The previous value for the key, or null when there was none. Java's
     put(K, V): an existing value -- or one inserted with this same key after
     this call, the two being indistinguishable under the monitor. */
  public synchronized V put(K key, V value) {
    if (key == null || value == null) {
      throw new NullPointerException("ConcurrentHashMap does not permit null keys or values")
    }
    return this.map.put(key, value)
  }

  /* The value for the key, or null when the key is not there. Called with a
     key of the same type the putting thread used: the erasion of V is the
     runtime's, and a value of the wrong type would be found by the cast at the
     call site, not here. */
  public synchronized V get(Object key) {
    if (key == null) {
      throw new NullPointerException("key is null")
    }
    return this.map.get(key)
  }

  /* The value the key held, or null when it was not there. */
  public synchronized V remove(Object key) {
    if (key == null) {
      throw new NullPointerException("key is null")
    }
    return this.map.remove(key)
  }

  public synchronized boolean containsKey(Object key) {
    if (key == null) {
      throw new NullPointerException("key is null")
    }
    return this.map.containsKey(key)
  }

  /* Exact, because nothing changes the table outside the monitor. */
  public synchronized int size() {
    return this.map.size()
  }

  public synchronized boolean isEmpty() {
    return this.map.isEmpty()
  }

  /* Every key, as an Enumeration -- Java's return type for this method in this
     class. The keys are copied under the monitor first, so the enumeration
     walks a fixed snapshot; see the class comment. */
  public synchronized Enumeration<K> keys() {
    List<K> snapshot = new ArrayList<K>(this.map.keySet())
    return new SetEnumeration<K>(snapshot)
  }

  /* Java's map toString: {k=v, k=v}. */
  public synchronized String toString() {
    return this.map.toString()
  }
}

/* java.util.concurrent.Semaphore: a count of permits, acquired and released.
 *
 * The count lives under the semaphore's own monitor and every waiter is inside
 * Object.wait on that same monitor, so a release that raises the count above
 * zero wakes everyone and each waiter re-tests the count before taking one.
 * That re-test is what makes a wake-up that arrives for another reason cost a
 * loop rather than a lost permit.
 *
 * No fairness. Java's fair semaphore hands permits out in arrival order; this
 * one does not promise an order at all, which is also what Java's unfair
 * constructor means, and the tests do not depend on one. */
class Semaphore {
  private int permits

  public Semaphore(int permits) {
    if (permits < 0) {
      throw new IllegalArgumentException("permits must be non-negative: " + permits)
    }
    this.permits = permits
  }

  public Semaphore(int permits, boolean fair) {
    this(permits)
    /* fair is accepted and ignored, and the class comment says why: this
       semaphore has no queue, and a constructor that silently did nothing would
       be worse if it did not say so. */
  }

  public void acquire() {
    synchronized (this) {
      while (this.permits <= 0) {
        this.wait(-1L)
      }
      this.permits = this.permits - 1
    }
  }

  /* Take a permit if there is one, without waiting. */
  public boolean tryAcquire() {
    synchronized (this) {
      if (this.permits <= 0) {
        return false
      }
      this.permits = this.permits - 1
      return true
    }
  }

  /* Wait up to millis for a permit; false when it never came. The deadline and
     the re-test are the CountDownLatch's, for the same reason: a notify that
     was not for this condition must not turn into a lost permit. */
  public boolean tryAcquire(long millis) {
    long deadline = System.nanoTime() + millis * 1000000L
    synchronized (this) {
      while (this.permits <= 0) {
        long left = deadline - System.nanoTime()
        if (left <= 0) {
          return false
        }
        long ms = left / 1000000L
        if (ms <= 0) {
          ms = 1
        }
        this.wait(ms)
      }
      this.permits = this.permits - 1
      return true
    }
  }

  public void release() {
    release(1)
  }

  /* Java's release(int) adds permits and has no upper bound; it also does not
     wait, because nothing is ever waited for on a release. */
  public void release(int n) {
    if (n < 0) {
      throw new IllegalArgumentException("permits must be non-negative: " + n)
    }
    synchronized (this) {
      this.permits = this.permits + n
      this.notifyAll()
    }
  }

  public int availablePermits() {
    synchronized (this) {
      return this.permits
    }
  }

  /* Answer the current count and take it to zero, which is what a caller uses
     to discard the permits a stopped producer had left. */
  public int drainPermits() {
    synchronized (this) {
      int n = this.permits
      this.permits = 0
      return n
    }
  }
}

/* java.util.concurrent.CyclicBarrier: a meeting point for a fixed number of
 * threads, reusable after the meeting.
 *
 * The generation counter is the whole of "cyclic": a thread that was woken by a
 * trip must not mistake the next generation's arrival signal for its own, so
 * every caller records the generation it is waiting on and re-tests it. The
 * last thread to arrive runs the barrier action, then publishes the next
 * generation and wakes everybody -- the action runs on the arriving thread,
 * under the monitor, which is what Java does too (its implementation runs it
 * inside the lock). */
class CyclicBarrier {
  private int parties
  private int waiting
  private int generation
  private boolean broken
  private Runnable action

  public CyclicBarrier(int parties) {
    if (parties <= 0) {
      throw new IllegalArgumentException("parties must be positive: " + parties)
    }
    this.parties = parties
  }

  public CyclicBarrier(int parties, Runnable action) {
    this(parties)
    this.action = action
  }

  public int getParties() {
    synchronized (this) {
      return this.parties
    }
  }

  public int getNumberWaiting() {
    synchronized (this) {
      return this.waiting
    }
  }

  public boolean isBroken() {
    synchronized (this) {
      return this.broken
    }
  }

  /* Wait until every party has arrived, and answer the party's arrival index:
     the first to arrive is 0, the one that trips the barrier is parties - 1,
     as Java's await does. The action runs once per generation. */
  public int await() {
    synchronized (this) {
      if (this.broken) {
        throw new BrokenBarrierException()
      }
      int gen = this.generation
      int index = this.waiting
      this.waiting = this.waiting + 1
      if (this.waiting == this.parties) {
        Runnable act = this.action
        if (act != null) {
          /* The action is Java's to run in the last arriving thread, and its
             failure breaks the barrier for everybody else -- which is why it
             runs here, inside the monitor, before the generation turns. */
          try {
            act.run()
          } catch (Throwable t) {
            this.broken = true
            this.waiting = 0
            this.generation = this.generation + 1
            this.notifyAll()
            throw new BrokenBarrierException()
          }
        }
        this.waiting = 0
        this.generation = this.generation + 1
        this.notifyAll()
        return index
      }
      while (!this.broken && gen == this.generation) {
        this.wait(-1L)
      }
      if (this.broken) {
        throw new BrokenBarrierException()
      }
      return index
    }
  }

  /* Break the barrier: every waiter is released with BrokenBarrierException and
     a later arrival sees the same. Java's reset does the same and then clears
     the flag for the next generation. */
  public void reset() {
    synchronized (this) {
      this.broken = false
      this.waiting = 0
      this.generation = this.generation + 1
      this.notifyAll()
    }
  }
}

/* java.util.concurrent.BrokenBarrierException: what a waiter on a broken
 * barrier is told. Java makes it checked; the checked-exception rule here skips
 * the standard library's own bodies, and a program catching it is unaffected by
 * which side of that line it is on. */
class BrokenBarrierException extends RuntimeException {
  public BrokenBarrierException() {}

  public BrokenBarrierException(String message) {
    super(message)
  }
}

/* java.util.concurrent.ReentrantLock: a mutual-exclusion lock with the two
 * properties Java's has -- it is reentrant, and unlock by a thread that does
 * not hold it is an error.
 *
 * It is a monitor, not a CAS, like everything in this file: lock() is
 * synchronized and takes the object's monitor, then counts. That means a
 * ReentrantLock held by one thread blocks another thread's lock() the same way
 * `synchronized` does, which is the observable behaviour a program uses; the
 * difference is that the monitor is reentered explicitly here, so a thread that
 * takes the lock twice must release twice, and getHoldCount says so. */
class ReentrantLock {
  private Thread owner
  private int holds

  public ReentrantLock() {}

  public ReentrantLock(boolean fair) {
    /* fair is accepted and ignored, for the reason Semaphore states: no queue
       exists to order, and a flag that did nothing silently would mislead. */
  }

  public void lock() {
    synchronized (this) {
      Thread me = Thread.currentThread()
      while (this.owner != null && this.owner != me) {
        this.wait(-1L)
      }
      this.owner = me
      this.holds = this.holds + 1
    }
  }

  /* False when another thread holds the lock; true when it was free or already
     this thread's, in which case the hold count rises, as Java's does. */
  public boolean tryLock() {
    synchronized (this) {
      Thread me = Thread.currentThread()
      if (this.owner != null && this.owner != me) {
        return false
      }
      this.owner = me
      this.holds = this.holds + 1
      return true
    }
  }

  public boolean tryLock(long millis) {
    long deadline = System.nanoTime() + millis * 1000000L
    synchronized (this) {
      Thread me = Thread.currentThread()
      while (this.owner != null && this.owner != me) {
        long left = deadline - System.nanoTime()
        if (left <= 0) {
          return false
        }
        long ms = left / 1000000L
        if (ms <= 0) {
          ms = 1
        }
        this.wait(ms)
      }
      this.owner = me
      this.holds = this.holds + 1
      return true
    }
  }

  /* Unlock one hold. The last one releases the owner and wakes the waiters; a
     caller that does not own the lock is IllegalMonitorStateException, which is
     also what java.util.concurrent.ReentrantLock throws. */
  public void unlock() {
    synchronized (this) {
      Thread me = Thread.currentThread()
      if (this.owner != me) {
        throw new IllegalMonitorStateException("current thread is not owner")
      }
      this.holds = this.holds - 1
      if (this.holds == 0) {
        this.owner = null
        this.notifyAll()
      }
    }
  }

  public boolean isLocked() {
    synchronized (this) {
      return this.owner != null
    }
  }

  public boolean isHeldByCurrentThread() {
    synchronized (this) {
      return this.owner == Thread.currentThread()
    }
  }

  public int getHoldCount() {
    synchronized (this) {
      if (this.owner != Thread.currentThread()) {
        return 0
      }
      return this.holds
    }
  }
}
