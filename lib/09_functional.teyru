package teyru

// The functional interfaces Java programs use most, with Java's method names,
// so a lambda written against java.util.function ports unchanged. Only the
// default methods that carry their weight are here; the rest of the package
// (BiConsumer, the primitive specialisations, the operator variants) is not.

interface Function<T, R> {
  R apply(T t)

  default <V> Function<V, R> compose(Function<V, T> before) {
    return v -> apply(before.apply(v))
  }

  default <V> Function<T, V> andThen(Function<R, V> after) {
    return t -> after.apply(apply(t))
  }

  static <T> Function<T, T> identity() {
    return t -> t
  }
}

interface BiFunction<T, U, R> {
  R apply(T t, U u)

  default <V> BiFunction<T, U, V> andThen(Function<R, V> after) {
    return (t, u) -> after.apply(apply(t, u))
  }
}

interface Consumer<T> {
  void accept(T t)

  default Consumer<T> andThen(Consumer<T> after) {
    return t -> {
      accept(t)
      after.accept(t)
    }
  }
}

interface Supplier<T> {
  T get()
}

interface Predicate<T> {
  boolean test(T t)

  default Predicate<T> and(Predicate<T> other) {
    return t -> test(t) && other.test(t)
  }

  default Predicate<T> or(Predicate<T> other) {
    return t -> test(t) || other.test(t)
  }

  default Predicate<T> negate() {
    return t -> !test(t)
  }

  static <T> Predicate<T> isEqual(Object target) {
    return t -> target == null ? t == null : target.equals(t)
  }
}

interface Runnable {
  void run()
}

interface Comparator<T> {
  int compare(T a, T b)

  default Comparator<T> reversed() {
    return (a, b) -> compare(b, a)
  }

  /* The comparing family, which is how a comparator is normally written. The
     key extractor's result has to be Comparable, and `? super U` is what makes
     a Comparable<String> usable where a Comparable<Object> is asked for --
     Java says the same thing in the same place. */
  static <T, U extends Comparable<? super U>> Comparator<T> comparing(Function<? super T, ? extends U> key) {
    return (a, b) -> key.apply(a).compareTo(key.apply(b))
  }

  static <T extends Comparable<? super T>> Comparator<T> naturalOrder() {
    return (a, b) -> a.compareTo(b)
  }

  static <T extends Comparable<? super T>> Comparator<T> reverseOrder() {
    return (a, b) -> b.compareTo(a)
  }

  /* thenComparing compares the second key only where the first two are equal,
     which is what makes a chain of keys a total order on the first one. */
  default Comparator<T> thenComparing(Comparator<? super T> other) {
    return (a, b) -> {
      int r = compare(a, b)
      if (r != 0) {
        return r
      }
      return other.compare(a, b)
    }
  }

  /* The key-extractor overload, which is the one a chain is usually written
     with: `comparing(Person::name).thenComparing(Person::age)` does not resolve
     without it, and it is the JDK's own spelling of the same call. The second
     key is only looked at where the first two are equal, because that is what
     the comparator it builds does. */
  default <U extends Comparable<? super U>> Comparator<T> thenComparing(Function<? super T, ? extends U> key) {
    return thenComparing(Comparator.comparing(key))
  }

  static <T> Comparator<T> nullsFirst(Comparator<? super T> c) {
    return (a, b) -> {
      if (a == null) {
        return b == null ? 0 : -1
      }
      if (b == null) {
        return 1
      }
      return c.compare(a, b)
    }
  }

  static <T> Comparator<T> nullsLast(Comparator<? super T> c) {
    return (a, b) -> {
      if (a == null) {
        return b == null ? 0 : 1
      }
      if (b == null) {
        return -1
      }
      return c.compare(a, b)
    }
  }
}
