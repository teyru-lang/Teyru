package teyru

// An HTTP client: java.net.http's shapes, and the wheel a program reaches for
// when it does not want to build a request by hand.
//
// A request is a method, a URI, headers and a body; a response is a status, the
// headers, and the body as text. The connection is kept and reused for the same
// host and port, which is what makes a second request to the same server cheap
// and what every client does.
//
// https:// works, and the policy it works under is worth stating where a caller
// can read it: the URL opens the same connection a http:// URL does and the TLS
// handshake runs on it, the certificate the server presents is verified against
// the system's trust anchors -- and, when a caller names one with trustStore, a
// CA file of its own as well -- and the host in the URL is checked against the
// certificate. A certificate that is not trusted and a certificate that is
// trusted but is not for that host fail the request with two different
// exceptions, because they are two different problems. There is no way to ask
// this client to accept anything: a TLS client that checks nothing hands the
// program a stream it believes is a particular server while anyone on the path
// can read and rewrite it.
//
// One thing is not here, and it is said rather than hidden: redirects. A 3xx is
// answered as it stands, with the Location header there for a caller that wants
// to follow it.

// HttpUrl is a URL split into the parts a client needs. Java's URI does more
// (relative resolution, encoding rules); this does what a request needs.
class HttpUrl {
  public String scheme = ""
  public String host = ""
  public int port = 0
  public String path = "/"
  public String query = ""

  public static HttpUrl of(String url) {
    HttpUrl u = new HttpUrl()
    String rest = url
    int schemeAt = url.indexOf("://")
    if (schemeAt > 0) {
      u.scheme = url.substring(0, schemeAt).toLowerCase()
      rest = url.substring(schemeAt + 3)
    }
    int slash = rest.indexOf('/')
    String authority = slash < 0 ? rest : rest.substring(0, slash)
    String tail = slash < 0 ? "/" : rest.substring(slash)
    int colon = authority.lastIndexOf(':')
    if (colon > 0) {
      u.host = authority.substring(0, colon)
      u.port = Integer.parseInt(authority.substring(colon + 1))
    } else {
      u.host = authority
      u.port = u.scheme.equals("https") ? 443 : 80
    }
    int q = tail.indexOf('?')
    if (q >= 0) {
      u.path = tail.substring(0, q)
      u.query = tail.substring(q + 1)
    } else {
      u.path = tail
    }
    return u
  }

  // target is what goes on the request line: the path, and the query when there
  // is one.
  public String target() {
    return query.length() == 0 ? path : path + "?" + query
  }

  public String authority() {
    boolean dflt = (scheme.equals("https") && port == 443) || (scheme.equals("http") == false && port == 80) ||
        (scheme.equals("http") && port == 80)
    return dflt ? host : host + ":" + port
  }
}

// HttpClientRequest is java.net.http.HttpClientRequest: the method, the target, the headers
// and the body, built through a builder because a request has more parts than a
// constructor should take.
class HttpClientRequest {
  public String method = "GET"
  public String url = ""
  public String body = ""
  public int timeoutMs = 0
  private List<String> headerNames = new ArrayList<String>()
  private List<String> headerValues = new ArrayList<String>()

  public static HttpClientRequest of(String method, String url) {
    HttpClientRequest r = new HttpClientRequest()
    r.method = method
    r.url = url
    return r
  }

  public HttpClientRequest header(String name, String value) {
    headerNames.add(name)
    headerValues.add(value)
    return this
  }

  public HttpClientRequest body(String text) {
    this.body = text
    return this
  }

  public HttpClientRequest contentType(String type) {
    return header("Content-Type", type)
  }

  /* acceptGzip asks the server for a compressed body. It is off unless a caller
     asks for it, because Accept-Encoding is the request saying what it can
     decode: a client that adds it without being told is a client that gets
     bytes it did not ask for. */
  public HttpClientRequest acceptGzip() {
    return header("Accept-Encoding", "gzip")
  }

  // timeout is the socket timeout a send uses, in milliseconds. Java's
  // HttpClientRequest.timeout takes a Duration; this language's clock is milliseconds
  // in the places that matter, so it is an int.
  public HttpClientRequest timeout(int ms) {
    timeoutMs = ms
    return this
  }

  public int headerCount() {
    return headerNames.size()
  }

  public String headerName(int i) {
    return headerNames.get(i)
  }

  public String headerValue(int i) {
    return headerValues.get(i)
  }

  public String header(String name) {
    for (int i = 0 : i < headerNames.size() : i++) {
      if (headerNames.get(i).toLowerCase().equals(name.toLowerCase())) {
        return headerValues.get(i)
      }
    }
    return ""
  }

  // render is the bytes of the request: the request line, the headers the
  // client has to send -- Host, the length, the connection -- and the ones the
  // caller added, then the body.
  public String render(HttpUrl u) {
    StringBuilder b = new StringBuilder()
    b.append(method).append(" ").append(u.target()).append(" HTTP/1.1\r\n")
    if (header("Host").length() == 0) {
      b.append("Host: ").append(u.authority()).append("\r\n")
    }
    for (int i = 0 : i < headerNames.size() : i++) {
      b.append(headerNames.get(i)).append(": ").append(headerValues.get(i)).append("\r\n")
    }
    if (body.length() > 0 && header("Content-Length").length() == 0) {
      b.append("Content-Length: ").append(body.length()).append("\r\n")
    }
    if (header("Connection").length() == 0) {
      b.append("Connection: keep-alive\r\n")
    }
    b.append("\r\n")
    b.append(body)
    return b.toString()
  }
}

// HttpClientResponse is java.net.http.HttpClientResponse: the status, the headers and the
// body of one exchange.
class HttpClientResponse {
  public int status = 0
  public String body = ""
  public String uri = ""
  private List<String> headerNames = new ArrayList<String>()
  private List<String> headerValues = new ArrayList<String>()

  public int statusCode() {
    return status
  }

  public String body() {
    return body
  }

  public String header(String name) {
    for (int i = 0 : i < headerNames.size() : i++) {
      if (headerNames.get(i).toLowerCase().equals(name.toLowerCase())) {
        return headerValues.get(i)
      }
    }
    return ""
  }

  public List<String> headerNames() {
    return headerNames
  }

  public void addHeader(String name, String value) {
    headerNames.add(name)
    headerValues.add(value)
  }

  public String headerName(int i) {
    return headerNames.get(i)
  }

  public String headerValue(int i) {
    return headerValues.get(i)
  }

  public int headerCount() {
    return headerNames.size()
  }

  public boolean isSuccessful() {
    return status >= 200 && status < 300
  }

  public String toString() {
    return "HTTP " + status + " " + body.length() + " bytes"
  }
}

// ClientResponseParser reads a response off a stream: the status line, the
// headers, and the body framed by whatever the headers say -- a length, a chunk
// list, or nothing at all, in which case the connection closes to end it. It is
// the reading half of the client, and it is separate from it so that it can be
// tested without a socket.
class ClientResponseParser {
  /* parse reads one response and expands a body the answer declared as
     compressed. The headers are left as they arrived, Content-Length among
     them: that length is what was on the wire, and the body a caller reads is
     what it said. */
  public static HttpClientResponse parse(SocketInputStream in) {
    HttpClientResponse res = parseRaw(in)
    if (res != null) {
      decodeBody(res)
    }
    return res
  }

  /* of is parse for a response that is already in hand, whole. */
  public static HttpClientResponse of(String raw) {
    HttpClientResponse res = ofRaw(raw)
    decodeBody(res)
    return res
  }

  /* decodeBody expands a body the answer said was gzip, and does nothing to
     one it did not. */
  public static void decodeBody(HttpClientResponse res) {
    String enc = res.header("Content-Encoding")
    if (enc.length() == 0 || enc.toLowerCase().indexOf("gzip") < 0) {
      return
    }
    res.body = Gzip.decompress(res.body)
  }

  /* parseRaw is the reading half on its own, without expanding a compressed
     body. It is public because the client needs the two halves apart: reading
     is transport -- a connection that broke is worth one more try -- and
     expanding is not, so a body that will not expand has to be raised where
     re-sending the request is not the answer. */
  public static HttpClientResponse parseRaw(SocketInputStream in) {
    String statusLine = in.readLine()
    if (statusLine == null) {
      return null
    }
    HttpClientResponse res = new HttpClientResponse()
    res.status = statusOf(statusLine)
    boolean chunked = false
    int length = -1
    while (true) {
      String line = in.readLine()
      if (line == null || line.isEmpty()) {
        break
      }
      int colon = line.indexOf(':')
      if (colon <= 0) {
        continue
      }
      String name = line.substring(0, colon).trim()
      String value = line.substring(colon + 1).trim()
      res.addHeader(name, value)
      String lower = name.toLowerCase()
      if (lower.equals("content-length")) {
        length = Integer.parseInt(value)
      }
      if (lower.equals("transfer-encoding") && value.toLowerCase().indexOf("chunked") >= 0) {
        chunked = true
      }
    }
    // a 1xx is an interim answer and the real one follows; 204 and 304 have no
    // body whatever their headers say
    if (res.status >= 100 && res.status < 200) {
      return parseRaw(in)
    }
    if (chunked) {
      res.body = readChunks(in)
      return res
    }
    if (res.status == 204 || res.status == 304) {
      return res
    }
    if (length >= 0) {
      byte[] buf = new byte[length]
      in.readFully(buf, 0, length)
      res.body = Net.stringFrom(buf, 0, length)
      return res
    }
    // no length and no chunks: the body ends when the connection does
    StringBuilder b = new StringBuilder()
    while (true) {
      int c = in.read()
      if (c < 0) {
        break
      }
      b.append((char) c)
    }
    res.body = b.toString()
    return res
  }

  // of parses a response that is already in hand, whole. It is the same reading
  // as parse does, for a caller that has the text rather than a stream -- a
  // test, a proxy, a cached answer -- and it is here rather than in the test so
  // that the two readings cannot drift apart.
  private static HttpClientResponse ofRaw(String raw) {
    int headEnd = raw.indexOf("\r\n\r\n")
    String head = headEnd < 0 ? raw : raw.substring(0, headEnd)
    String body = headEnd < 0 ? "" : raw.substring(headEnd + 4)
    String[] lines = head.split("\r\n")
    HttpClientResponse res = new HttpClientResponse()
    res.status = statusOf(lines[0])
    int length = -1
    boolean chunked = false
    for (int i = 1 : i < lines.length : i++) {
      int colon = lines[i].indexOf(':')
      if (colon <= 0) {
        continue
      }
      String name = lines[i].substring(0, colon).trim()
      String value = lines[i].substring(colon + 1).trim()
      res.addHeader(name, value)
      String lower = name.toLowerCase()
      if (lower.equals("content-length")) {
        length = Integer.parseInt(value)
      }
      if (lower.equals("transfer-encoding") && value.toLowerCase().indexOf("chunked") >= 0) {
        chunked = true
      }
    }
    if (res.status == 204 || res.status == 304) {
      return res
    }
    if (chunked) {
      res.body = unchunk(body)
      return res
    }
    if (length >= 0 && length <= body.length()) {
      res.body = body.substring(0, length)
      return res
    }
    res.body = body
    return res
  }

  // unchunk decodes a chunked body that is already in hand.
  public static String unchunk(String raw) {
    StringBuilder b = new StringBuilder()
    int at = 0
    while (at < raw.length()) {
      int eol = raw.indexOf("\r\n", at)
      if (eol < 0) {
        break
      }
      int n = Integer.parseInt(raw.substring(at, eol).trim(), 16)
      if (n == 0) {
        break
      }
      int from = eol + 2
      b.append(raw.substring(from, from + n))
      at = from + n + 2
    }
    return b.toString()
  }

  public static int statusOf(String statusLine) {
    String[] parts = statusLine.split(" ")
    if (parts.length < 2) {
      throw new IllegalStateException("not an HTTP status line: " + statusLine)
    }
    return Integer.parseInt(parts[1])
  }

  static String readChunks(SocketInputStream in) {
    StringBuilder b = new StringBuilder()
    while (true) {
      String size = in.readLine()
      if (size == null) {
        break
      }
      int n = Integer.parseInt(size.trim(), 16)
      if (n == 0) {
        in.readLine()
        break
      }
      byte[] buf = new byte[n]
      in.readFully(buf, 0, n)
      b.append(Net.stringFrom(buf, 0, n))
      in.readLine()
    }
    return b.toString()
  }
}

// HttpClient is java.net.http.HttpClient for a blocking client: it connects, it
// sends, it keeps the connection for the next request to the same authority.
class HttpClient {
  private Socket socket
  private String connectedTo = ""
  private int timeoutMs = 30000
  // The PEM file whose certificates are trusted in addition to the system's, or
  // "" for none. It is a path and not a context because a client is built per
  // request by Http, and reading a file is what happens once per connection
  // rather than once per builder call.
  private String trustCa = ""

  public static HttpClient newHttpClient() {
    return new HttpClient()
  }

  public HttpClient connectTimeout(int ms) {
    timeoutMs = ms
    return this
  }

  // trustStore adds a CA file to the anchors this client verifies against: the
  // certificates in it are trusted as well as the system's, which is what a
  // server with a private CA -- or a test with a self-signed certificate --
  // needs. It does not replace them, and there is no call that removes them:
  // the point of a trust store is that a name is either covered by a
  // certificate someone vouched for or is not.
  public HttpClient trustStore(String caFile) {
    this.trustCa = caFile
    return this
  }

  public HttpClientResponse send(HttpClientRequest request) {
    HttpUrl u = HttpUrl.of(request.url)
    if (u.scheme.length() > 0 && u.scheme.equals("http") == false && u.scheme.equals("https") == false) {
      throw new IllegalStateException("unsupported scheme: " + u.scheme)
    }
    HttpClientResponse res = exchange(u, request)
    res.uri = request.url
    return res
  }

  private HttpClientResponse exchange(HttpUrl u, HttpClientRequest request) {
    int tries = 0
    while (true) {
      Socket s = connection(u, tries > 0)
      HttpClientResponse res = null
      try {
        s.setSoTimeout(request.timeoutMs > 0 ? request.timeoutMs : timeoutMs)
        s.getOutputStream().write(request.render(u))
        s.getOutputStream().flush()
        // The reading half only, and the test below is why: a connection that
        // broke between two requests is worth sending the request again, and a
        // body that will not expand is not. Expanding it here would put a
        // compression failure inside the retry, so a client would send a POST a
        // second time because it could not read the first answer -- a second
        // side effect, which is worse than the error it is covering for.
        res = ClientResponseParser.parseRaw(s.getInputStream())
      } catch (IOException e) {
        // a connection the server closed between requests is the one case worth
        // retrying: the request itself may not have been read
        close()
        tries++
        if (tries > 1) {
          throw e
        }
        continue
      }
      if (res == null) {
        throw new IllegalStateException("the server closed the connection without answering")
      }
      // the connection stays open unless the server said otherwise, which is
      // what makes the next request to the same authority one write
      if (res.header("Connection").toLowerCase().indexOf("close") >= 0) {
        close()
      }
      // The expansion happens once, on the answer this call is going to return,
      // and its failure is the caller's to see as it is.
      ClientResponseParser.decodeBody(res)
      return res
    }
  }

  private Socket connection(HttpUrl u, boolean fresh) {
    String key = u.host + ":" + u.port
    if (fresh == false && socket != null && connectedTo.equals(key)) {
      return socket
    }
    close()
    socket = new Socket(u.host, u.port)
    socket.setSoTimeout(timeoutMs)
    // https is the same connection with a handshake on it, and the timeout is
    // set before the handshake rather than after it: a peer that accepts the
    // connection and then says nothing would otherwise hold the request for as
    // long as it likes. Everything above this -- the request, the response
    // parser, the reuse of the connection for the next request -- is the same
    // code for both schemes.
    if (u.scheme.equals("https")) {
      socket = TlsSocket.start(socket, u.host, trustCa)
    }
    connectedTo = key
    return socket
  }

  public void close() {
    if (socket != null) {
      socket.close()
      socket = null
      connectedTo = ""
    }
  }
}

// Http is the wheel: the four verbs a program reaches for, with the request
// built for it. java.net.http has no such class -- a program builds a request
// and sends it -- and this is here because most programs are one call.
class Http {
  public static HttpClientResponse get(String url) {
    return send(HttpClientRequest.of("GET", url))
  }

  public static HttpClientResponse post(String url, String body) {
    return send(HttpClientRequest.of("POST", url).contentType("text/plain").body(body))
  }

  public static HttpClientResponse postJson(String url, String json) {
    return send(HttpClientRequest.of("POST", url).contentType("application/json").body(json))
  }

  public static HttpClientResponse putJson(String url, String json) {
    return send(HttpClientRequest.of("PUT", url).contentType("application/json").body(json))
  }

  public static HttpClientResponse delete(String url) {
    return send(HttpClientRequest.of("DELETE", url))
  }

  public static HttpClientResponse head(String url) {
    return send(HttpClientRequest.of("HEAD", url))
  }

  private static HttpClientResponse send(HttpClientRequest request) {
    HttpClient client = HttpClient.newHttpClient()
    try {
      return client.send(request)
    } finally {
      client.close()
    }
  }
}
