package teyru

/* java.util.concurrent's executor half: Callable, Future, ExecutorService, and
 * the pools Executors' factories hand out.
 *
 * The shape is Java's. A Future is the handle on a task; a worker thread takes
 * a task at a time off a queue and runs it on itself, so a task's stack,
 * allocations and monitors belong to that thread exactly as they would if the
 * program had started the Thread itself; submit(Callable) answers a Future
 * whose get() waits for the answer; shutdown() stops the pool taking work and
 * lets the tasks that were already taken finish; awaitTermination waits for the
 * workers to leave.
 *
 * What this is built on, because it changes how a reader should reason about
 * it:
 *
 *   - Monitors, and only monitors, for everything but the waiting. The queue is
 *     an ArrayDeque under the pool's monitor, a Future's answer is written under
 *     its own, and AtomicInteger in 38_concurrent_collections is a monitor.
 *     The runtime has no hardware atomics, so nothing in this file is lock-free
 *     and nothing scales the way java.util.concurrent scales: a pool of four
 *     threads taking tasks from one queue contends on one monitor, and that is
 *     the price of the simple correct thing.
 *
 *   - Each wait is Object.wait on the monitor that owns the condition, which is
 *     what java.util.concurrent does and what this runtime carries: an idle
 *     worker waits on the pool's monitor for a task, a get() whose answer is not
 *     there yet waits on the future's monitor, and awaitTermination waits on the
 *     pool's monitor for the workers to reach zero. Each of those is closed by a
 *     notifyAll from the thread that changed the thing waited for -- execute()
 *     when a task arrives, run() and cancel() when a future is answered,
 *     shutdown() and a worker leaving when the pool's state moves -- and every
 *     wait re-tests its condition, so a wait that returns for any other reason
 *     costs a loop and not a task.
 *
 *     The three waits are not the same wait, which is why the monitor is
 *     notified with notifyAll rather than notify: a worker waiting for a task
 *     and a caller waiting for the worker count to reach zero are waiting on one
 *     monitor for two different conditions, and notify() is free to wake either
 *     of them.
 *
 *   - CountDownLatch, in 38_concurrent_collections.teyru, is the other
 *     synchronizer here, and it waits the same way: its awaiters are inside
 *     Object.wait on the latch's own monitor, and the countDown that empties it
 *     wakes every one of them. Several threads waiting on one object and one
 *     notifyAll releasing them all is the pattern that matters there, and it is
 *     the one this runtime is built to carry.
 *
 *   - This pool does not interrupt. Threads can be interrupted now
 *     (Thread.interrupt), but nothing here uses it: shutdownNow() drops the
 *     tasks that have not started and hands them back, and the tasks that are
 *     running run to their end. Its comment says so, and no method here takes
 *     Java's mayInterruptIfRunning flag, because a flag that silently did
 *     nothing would mislead exactly the reader it was for.
 *
 *   - There is no TimeUnit in this standard library. Every duration here is
 *     milliseconds, the unit Thread.sleep takes.
 *
 * A task that throws is reported, never swallowed: FutureTask.run catches the
 * throwable and keeps it, and get() throws ExecutionException with it as the
 * cause, which is what Java does. A task that came in through execute() and
 * throws has no Future to carry it, and it is handled the way Java's worker
 * handles it: the worker thread dies with the throwable (the runtime's uncaught
 * handler prints Java's line), and the pool starts a replacement so a fixed
 * pool does not quietly shrink.
 *
 * A pool this program does not shut down outlives it: the runtime waits for
 * every thread the program started before it exits, so a program that builds a
 * pool and returns from main without shutting it down does not end until that
 * pool's workers do -- which for a fixed pool is never. Shut your pools down.
 *
 * Not implemented, and deliberately not declared: TimeUnit, invokeAll,
 * invokeAny, submit(Runnable), the scheduled executor, the fork/join pool,
 * CompletionService, ThreadFactory, the uncaught-exception handler, and
 * ThreadPoolExecutor's own tuning surface. */

/* A task that answers a value. Java's functional interfaces cannot be written
   as lambdas here -- this language has none -- so a task is an object with a
   call method, which is what a program passes to submit. */
interface Callable<V> {
  V call()
}

/* The handle on a task: Java's Future, with Java's four methods. */
interface Future<V> {
  /* The answer, waiting for it until it is there. Throws ExecutionException
     carrying the task's own throwable when the task threw, and
     CancellationException when it was cancelled. */
  V get()
  /* True once the task has finished, thrown, or been cancelled. */
  boolean isDone()
  boolean isCancelled()
  /* Cancel a task that has not started yet: the worker that takes it will find
     it cancelled and skip it. A task that has already started is not cancelled
     and this answers false -- this Future does not interrupt the worker, so
     nothing could stop it, and Java's cancel(true) is the form that would
     promise one. Java's cancel(false), which is this. */
  boolean cancel()
}

/* Something that runs a Runnable. Java's Executor, and the half of the
   interface that has nothing to do with answers. */
interface Executor {
  void execute(Runnable command)
}

/* Java's ExecutorService: submitting, and shutting down. */
interface ExecutorService extends Executor {
  < T > Future<T> submit(Callable<T> task)
  /* Run every task and wait for all of them, answering their futures in the
     list's order. Java's invokeAll; a task that throws fails its own future and
     does not stop the others. */
  < T > List<Future<T>> invokeAll(List<Callable<T>> tasks)
  /* Run every task and answer the first value to arrive; if every task fails,
     ExecutionException carries the last failure. */
  < T > T invokeAny(List<Callable<T>> tasks)
  /* Stop taking work. The tasks already handed to the pool -- the ones queued
     and the ones running -- finish, and then the workers leave. */
  void shutdown()
  /* Stop now: no new task is taken and the queued ones are handed back. It
     does not interrupt a task that is already running, so that task runs to its
     end. The futures of the tasks handed back never complete, as in Java. */
  List<Runnable> shutdownNow()
  /* Wait up to this many milliseconds for every worker to leave, answering
     true when the pool has finished. A duration of zero or less does not wait;
     it answers whether the pool has already finished. The wait is on the pool's
     monitor, for the worker count to reach zero, and the worker that takes it
     there is the one that wakes the caller. */
  boolean awaitTermination(long millis)
  boolean isShutdown()
  /* True once shutdown() or shutdownNow() has been called and every worker has
     left. A pool nobody has shut down is never terminated. */
  boolean isTerminated()
}

/* What a task's failure arrives as: get() throws this, with the throwable the
   task threw as its cause. Java's class of the same name, and checked there
   and here -- although this language has no throws clause, so nothing makes a
   caller write the catch. It is the reason a failed task is never silently
   answered with null. */
class ExecutionException extends Exception {
  public ExecutionException(String message) {
    super(message)
  }
  public ExecutionException(String message, Throwable cause) {
    super(message, cause)
  }
  /* Java's Throwable(cause) copies the cause's toString into the message; this
     standard library's sets the cause and leaves the message null, so the
     copy is made here to keep the message a program prints the same one Java
     would. */
  public ExecutionException(Throwable cause) {
    super(cause.toString(), cause)
  }
}

/* get() on a future whose task was cancelled. Java's CancellationException,
   which extends IllegalStateException for the same reason: the program that
   cancelled the task is the program calling get(). */
class CancellationException extends IllegalStateException {
  public CancellationException() {}
  public CancellationException(String message) {
    super(message)
  }
}

/* Handed to execute() or submit() after the pool has been shut down. Java's
   class of the same name. */
class RejectedExecutionException extends RuntimeException {
  public RejectedExecutionException() {}
  public RejectedExecutionException(String message) {
    super(message)
  }
}

/* A task with a place to put its answer: Java's FutureTask, which is both the
 * Future a caller holds and the Runnable a worker runs.
 *
 * The answer, the throwable and the flags are written and read under this
 * object's monitor, so get() and run() agree about whether the answer is there:
 * get() waits on that monitor while the flag says the task has not finished,
 * and run() and cancel() wake it when they set the flag. Any number of threads
 * may call get() on one future, which is why the wakeup is a notifyAll. */
class FutureTask<T> implements Future<T>, Runnable {
  private Callable<T> callable
  private T value
  private Throwable failure
  /* done: the task has finished, thrown or been cancelled. running: a worker
     is inside call() right now, which is what makes cancel() refuse -- a
     cancelled task is one that never started. */
  private boolean done
  private boolean running
  private boolean cancelled

  public FutureTask(Callable<T> callable) {
    this.callable = callable
  }

  /* Run the task. A worker thread calls this; so may a program, and then the
     task runs on the calling thread. Running a task twice is a no-op the
     second time, as it is in Java. */
  public void run() {
    Callable<T> task
    synchronized (this) {
      if (this.done || this.running) {
        return
      }
      this.running = true
      task = this.callable
    }
    /* Outside the monitor: the task may take minutes, may take monitors of its
       own, and may call get() on a future of its own. Holding this future's
       monitor across it would make a concurrent get() and a concurrent
       cancel() -- both of which only want to read or set a flag -- wait for
       the task to finish. */
    T answer = null
    Throwable thrown = null
    try {
      answer = task.call()
    } catch (Throwable t) {
      thrown = t
    }
    synchronized (this) {
      this.running = false
      this.value = answer
      this.failure = thrown
      this.done = true
      /* Whoever is inside get() is waiting for this line, and there may be
         several of them. */
      this.notifyAll()
    }
  }

  /* The answer, waiting for it until it is there. The wait is on this object's
     monitor, which run() and cancel() hold when they mark the task done, so the
     flag cannot go true between the test below and the wait: either get() sees
     it, or it is inside the wait when the notifyAll arrives. */
  public T get() {
    synchronized (this) {
      while (!this.done) {
        this.wait(-1L)
      }
      return this.answer()
    }
  }

  /* The answer, or the throwable standing in for it. Called with this object's
     monitor held, and only when the task is done. */
  private T answer() {
    if (this.cancelled) {
      throw new CancellationException("the task was cancelled")
    }
    if (this.failure != null) {
      throw new ExecutionException(this.failure)
    }
    return this.value
  }

  public boolean isDone() {
    synchronized (this) {
      return this.done
    }
  }

  public boolean isCancelled() {
    synchronized (this) {
      return this.cancelled
    }
  }

  public boolean cancel() {
    synchronized (this) {
      if (this.done || this.running) {
        return false
      }
      this.cancelled = true
      this.done = true
      /* A cancelled future is a finished one as far as get() is concerned: it
         is answered with a CancellationException rather than waited on. */
      this.notifyAll()
      return true
    }
  }
}

/* The pool behind all three factories.
 *
 * Two numbers describe a pool: how many workers it keeps alive (core -- its
 * workers never give up), and how long an idle worker may wait for work before
 * giving up (keepAlive, in milliseconds, 0 meaning never). A fixed pool of four
 * is 4 and 0; the single-thread executor is 1 and 0; the cached pool is 0 and
 * 60000, so no worker is kept, one is started whenever a task arrives and none
 * is idle, and one that has been idle a minute leaves.
 *
 * Everything the pool decides is decided under this object's monitor: the
 * queue, the number of live workers, and how many are idle. A worker takes a
 * task, or counts itself idle, in the same critical section, so a task can
 * never fall into the gap between "there is nothing to do" and "this worker
 * goes idle": either the worker finds the task, or it has already said it is
 * idle when the task arrives, and then execute() either has an idle worker to
 * pick it up or starts one.
 *
 * Two kinds of thread wait on this monitor, and each of them waits on a
 * condition the same monitor guards: a worker with nothing to take waits in
 * claim() for a task to arrive (or for its keep-alive to run out, or for the
 * pool to be shut down), and awaitTermination waits for the worker count to
 * reach zero. Because those are different conditions on one monitor, every
 * change is announced with notifyAll: execute() when it queues a task,
 * shutdown() and shutdownNow() when the queue becomes take-it-or-leave,
 * workerFailed() when a worker is replaced, and claim() itself when a worker
 * takes the last count of workers down to the one an awaitTermination is
 * waiting for. That last sentence has a price and it is worth stating: a task
 * arriving at an idle pool wakes every idle worker rather than one of them,
 * because a notify() there is free to wake the awaitTermination waiter instead
 * and leave the task in the queue. Waking a worker that then finds nothing to
 * do costs one monitor acquisition, and it is the price of carrying both waits
 * on one monitor -- a second condition variable, which this language has no way
 * to write, is what java.util.concurrent uses here. */
class ThreadPool implements ExecutorService {
  /* Oldest first, taken from the front. ArrayDeque rather than ArrayList
     because taking a task has to cost O(1): an ArrayList would shift every
     element of the queue on every take. */
  private ArrayDeque<Runnable> queue = new ArrayDeque<Runnable>()
  private int core
  private long keepAlive
  private int workers
  /* The workers that have found the queue empty: they are inside claim()'s
     wait, or between telling us so and getting there. What execute() reads to
     decide whether a cached pool has to start another worker, and the state a
     task arriving in an idle pool is handed to by the notifyAll. */
  private int idle
  /* shutdown: no new task is taken. stopped: shutdownNow was called, so the
     queued tasks were dropped and a dead worker is not replaced. */
  private boolean shutdown
  private boolean stopped
  private int created
  private String prefix
  /* How workers are made. A null factory is the default naming (prefix+number),
     which is what every pool built without one gets. */
  private ThreadFactory factory

  /* Called with this pool's monitor held. */
  private void startWorker() {
    this.workers = this.workers + 1
    this.created = this.created + 1
    final ThreadPool self = this
    /* The worker is this thread's whole life: take a task, run it here, and
       wait until there is another. It is written as an object rather than a
       method because a thread runs a Runnable, and the loop must go on for as
       long as the pool wants the worker. */
    Runnable body = new Runnable() {
      public void run() {
        while (true) {
          Runnable task = self.claim()
          if (task == null) {
            return
          }
          try {
            task.run()
          } catch (Throwable failure) {
            /* A task that came in through execute() has no Future to carry its
               failure, and this is the moment Java's worker thread dies with
               it: the runtime's uncaught handler prints Java's line ("Exception
               in thread ..."), the thread ends, and the program carries on.
               Putting a replacement in its place before it dies is what
               ThreadPoolExecutor does, and it is why a fixed pool is still four
               threads afterwards. A task that came in through submit() never
               reaches here: FutureTask catches its throwable and keeps it for
               get(). */
            self.workerFailed()
            throw failure
          }
        }
      }
    }
    /* The factory decides the thread's name and daemon flag; the default is the
       pool-N-thread-M naming java.util.concurrent uses. */
    Thread t = this.factory == null ? new Thread(body, this.prefix + this.created) : this.factory.newThread(body)
    t.start()
  }

  public ThreadPool(int core, long keepAliveMillis, String prefix) {
    this(core, keepAliveMillis, prefix, null)
  }

  public ThreadPool(int core, long keepAliveMillis, String prefix, ThreadFactory factory) {
    this.core = core
    this.keepAlive = keepAliveMillis
    this.prefix = prefix
    this.factory = factory
    /* Under the monitor, which is what startWorker expects: a worker started
       a moment ago is already in claim(), and the fields it guards must not be
       written from outside the critical section it reads them in. The worker
       that has just been created blocks on this monitor until the constructor
       is done with it, which costs nothing. */
    synchronized (this) {
      for (int i = 0 : i < core : i++) {
        this.startWorker()
      }
    }
  }

  public void execute(Runnable command) {
    if (command == null) {
      throw new NullPointerException("the task is null")
    }
    synchronized (this) {
      if (this.shutdown) {
        throw new RejectedExecutionException("the pool has been shut down")
      }
      this.queue.addLast(command)
      if (this.core == 0 && this.idle == 0) {
        /* no worker is kept, and none is sitting idle to take it: this is where
           a cached pool grows with the work offered to it */
        this.startWorker()
      }
      /* An idle worker is inside claim()'s wait, and this is what takes it out
         of it. notifyAll because the same monitor holds awaitTermination's
         waiters, which are waiting for something else. */
      this.notifyAll()
    }
  }

  public < T > Future<T> submit(Callable<T> task) {
    if (task == null) {
      throw new NullPointerException("the task is null")
    }
    FutureTask<T> future = new FutureTask<T>(task)
    this.execute(future)
    return future
  }

  public < T > List<Future<T>> invokeAll(List<Callable<T>> tasks) {
    List<Future<T>> futures = new ArrayList<Future<T>>()
    for (int i = 0 : i < tasks.size() : i++) {
      futures.add(this.submit(tasks.get(i)))
    }
    /* Waiting on each in order does not delay the answer: invokeAll waits for
       every task by contract, and get() on an earlier future returns as soon as
       that one is done. */
    for (int i = 0 : i < futures.size() : i++) {
      futures.get(i).get()
    }
    return futures
  }

  /* invokeAny: every task is submitted, and the first one to answer wins. The
     tasks are wrapped so that the queue's own failure path does not matter: the
     wrapper records a value and opens the latch, or records the failure and
     opens it only when the last task has failed. */
  public < T > T invokeAny(List<Callable<T>> tasks) {
    if (tasks.size() == 0) {
      throw new IllegalArgumentException("no tasks")
    }
    final CountDownLatch done = new CountDownLatch(1)
    final Object[] winner = new Object[1]
    final boolean[] won = new boolean[1]
    final Throwable[] lastFailure = new Throwable[1]
    final int[] remaining = new int[] { tasks.size() }
    for (int i = 0 : i < tasks.size() : i++) {
      final Callable<T> task = tasks.get(i)
      /* The wrapper is a named value before it is submitted: inference on a
         call whose only argument is an anonymous class does not settle T, and
         naming it does. */
      Callable<Void> wrapper = new Callable<Void>() {
        public Void call() {
          try {
            T v = task.call()
            synchronized (winner) {
              if (!won[0]) {
                won[0] = true
                winner[0] = v
              }
            }
            done.countDown()
          } catch (Throwable thrown) {
            boolean last = false
            synchronized (winner) {
              lastFailure[0] = thrown
              remaining[0] = remaining[0] - 1
              last = remaining[0] == 0
            }
            if (last) {
              done.countDown()
            }
          }
          return null
        }
      }
      this.submit(wrapper)
    }
    done.await()
    synchronized (winner) {
      if (won[0]) {
        return (T) winner[0]
      }
    }
    throw new ExecutionException("no task completed successfully", lastFailure[0])
  }

  public void shutdown() {
    synchronized (this) {
      this.shutdown = true
      /* Every waiting worker has to look at the queue and then at this flag,
         and leave when there is nothing left to take. */
      this.notifyAll()
    }
  }

  public List<Runnable> shutdownNow() {
    List<Runnable> dropped = new ArrayList<Runnable>()
    synchronized (this) {
      /* What this does not do is interrupt a task that has started: the
         worker that is inside run() is inside it until run() returns. What it
         does do is refuse new work, hand back every task that never started,
         and let the workers leave as soon as the task they are on is done.
         Java's shutdownNow also interrupts the running tasks; this pool does
         not use interrupt, and nothing pretends otherwise. */
      this.shutdown = true
      this.stopped = true
      while (!this.queue.isEmpty()) {
        dropped.add(this.queue.removeFirst())
      }
      /* The workers that are waiting have nothing to take now, so they are one
         look away from leaving. */
      this.notifyAll()
    }
    return dropped
  }

  /* Wait for the worker count to reach zero, up to this many milliseconds. The
     last worker to leave is the one that wakes the callers here (see the
     claim() below); the deadline is this thread's own business and is answered
     by the wait's timeout. */
  public boolean awaitTermination(long millis) {
    long deadline = System.nanoTime() + millis * 1000000L
    synchronized (this) {
      while (this.workers > 0) {
        long left = deadline - System.nanoTime()
        if (left <= 0) {
          return false
        }
        long millisLeft = left / 1000000L
        if (millisLeft <= 0) {
          /* under a millisecond left, and wait counts in milliseconds: spend it
             as one, and let the loop answer -- the same rounding every timed
             wait in this library does */
          millisLeft = 1
        }
        this.wait(millisLeft)
      }
      return true
    }
  }

  public boolean isShutdown() {
    synchronized (this) {
      return this.shutdown
    }
  }

  public boolean isTerminated() {
    synchronized (this) {
      return this.shutdown && this.workers == 0
    }
  }

  /* The next task for this worker, or null when the pool is finished with it.
     The worker is idle from the moment it finds the queue empty here until the
     moment it takes a task, and it waits between the two -- a look at the queue
     under this monitor, a wait that gives the monitor up, and a look again.

     The idle count is raised under the monitor and before the first look, and
     execute() queues its task and notifies under that same monitor, so there is
     no arrangement in which a task sits in the queue with every worker
     convinced it has nothing to do: execute() either finds an idle worker --
     this one, counted or already inside the wait -- or starts one itself. */
  private Runnable claim() {
    /* When this stretch of idleness started, for the keep-alive below. One call
       of claim is one stretch: it ends when a task is taken. */
    long idleSince = System.nanoTime()
    synchronized (this) {
      this.idle = this.idle + 1
      while (true) {
        if (!this.queue.isEmpty()) {
          this.idle = this.idle - 1
          return this.queue.removeFirst()
        }
        if (this.shutdown) {
          /* Nothing left to take and no more coming: this is where a worker
             normally leaves. The queue is the only thing that keeps a worker
             past shutdown, which is what makes "shutdown waits for the tasks
             that were already accepted" true. */
          this.idle = this.idle - 1
          this.workers = this.workers - 1
          /* This may be the worker an awaitTermination is waiting on. */
          this.notifyAll()
          return null
        }
        /* How long this worker may wait for work: no timeout at all for a pool
           that keeps its workers, the rest of the keep-alive for one that does
           not. The timeout is the whole of what ends a cached worker's wait --
           nothing notifies a worker that the pool has decided it has been idle
           long enough -- so it is the keep-alive itself, waited out in one go
           and re-tested around it. */
        long millis = -1L
        if (this.keepAlive > 0) {
          millis = this.keepAlive - (System.nanoTime() - idleSince) / 1000000L
          if (millis <= 0) {
            /* Idle for as long as this pool keeps anyone, and no work to take:
               the worker leaves. A cached pool is the only pool with a
               keep-alive above zero, and this is what makes it shrink back to
               no threads at all once the work stops. Nothing is lost by
               leaving: the queue was empty in this same critical section, and
               execute() starts a worker for whatever arrives after the idle
               count reaches zero. */
            this.idle = this.idle - 1
            this.workers = this.workers - 1
            this.notifyAll()
            return null
          }
        }
        this.wait(millis)
      }
    }
  }

  /* A worker died of a task's throwable, and this keeps the pool the size it
     was. Called with no monitor held. */
  private void workerFailed() {
    synchronized (this) {
      this.workers = this.workers - 1
      if (!this.stopped) {
        this.startWorker()
      }
      /* A replacement puts the count straight back, but a worker that died
         while the pool was stopping does not get one, and then this is a worker
         an awaitTermination has been waiting to see leave. */
      this.notifyAll()
    }
  }
}

/* The pool factories java.util.concurrent.Executors has, and only those: the
   scheduled and work-stealing ones need machinery this standard library does
   not have. */
/* java.util.concurrent.TimeUnit: the seven units and their conversions.

   Java's is an enum whose constants carry a scale; this is a final class with
   the same seven values and the same arithmetic. The library's own APIs still
   take milliseconds (see the concurrency section of the docs), so a caller uses
   this to convert into the unit an API wants, and sleep() is the one method that
   waits. */
class TimeUnit {
  public static final TimeUnit NANOSECONDS = new TimeUnit("NANOSECONDS", 1L)
  public static final TimeUnit MICROSECONDS = new TimeUnit("MICROSECONDS", 1000L)
  public static final TimeUnit MILLISECONDS = new TimeUnit("MILLISECONDS", 1000000L)
  public static final TimeUnit SECONDS = new TimeUnit("SECONDS", 1000000000L)
  public static final TimeUnit MINUTES = new TimeUnit("MINUTES", 60000000000L)
  public static final TimeUnit HOURS = new TimeUnit("HOURS", 3600000000000L)
  public static final TimeUnit DAYS = new TimeUnit("DAYS", 86400000000000L)

  private final String name
  private final long nanosPerUnit

  private TimeUnit(String name, long nanosPerUnit) {
    this.name = name
    this.nanosPerUnit = nanosPerUnit
  }

  public String name() {
    return this.name
  }

  public String toString() {
    return this.name
  }

  public long toNanos(long d) {
    return d * this.nanosPerUnit
  }

  public long toMicros(long d) {
    return d * this.nanosPerUnit / 1000L
  }

  public long toMillis(long d) {
    return d * this.nanosPerUnit / 1000000L
  }

  public long toSeconds(long d) {
    return d * this.nanosPerUnit / 1000000000L
  }

  public long toMinutes(long d) {
    return d * this.nanosPerUnit / 60000000000L
  }

  public long toHours(long d) {
    return d * this.nanosPerUnit / 3600000000000L
  }

  public long toDays(long d) {
    return d * this.nanosPerUnit / 86400000000000L
  }

  /* The same arithmetic in the other direction: a duration in this unit, as the
     target unit. */
  public long convert(long sourceDuration, TimeUnit sourceUnit) {
    long nanos = sourceDuration * sourceUnit.nanosPerUnit
    return nanos / this.nanosPerUnit
  }

  /* Java's sleep: a wait in this unit, through Thread.sleep's milliseconds. A
     zero or negative duration returns at once -- Java's implementation only
     calls Thread.sleep when the timeout is positive, so a negative one is a
     silent no-op rather than Thread.sleep's IllegalArgumentException. A
     positive duration below a millisecond still sleeps a millisecond, which is
     the resolution the runtime has. */
  public void sleep(long timeout) {
    if (timeout <= 0) {
      return
    }
    long ms = timeout * this.nanosPerUnit / 1000000L
    Thread.sleep(ms > 0 ? ms : 1L)
  }
}

/* java.util.concurrent.ThreadFactory: how a pool makes its worker threads.

   The pool asks the factory for each worker it starts, so a program can name
   them, make them daemons, or hand out its own subclass. Java's default factory
   numbers them; Executors.defaultThreadFactory() is here for the same reason. */
interface ThreadFactory {
  Thread newThread(Runnable r)
}

/* java.util.concurrent.CompletionService: a queue of futures in completion
   order, rather than in submission order. Java's shape has a BlockingQueue
   inside; this has the same monitor-backed list the rest of the library uses for
   a queue, so take() waits on the service's monitor and the task that finishes
   wakes the waiter.

   The wrapper is what makes the order work: the pool runs the real task, and
   when it returns the wrapper adds its own future to the completed list before
   returning. A task that throws still reaches that point, because FutureTask
   keeps the failure inside the future -- take() then answers a future whose
   get() throws, which is Java's behaviour. */
interface CompletionService<V> {
  Future<V> submit(Callable<V> task)
  /* The next future to finish, waiting for one. */
  Future<V> take()
  /* The next finished future, or null when none has finished yet. */
  Future<V> poll()
  /* The next finished future, waiting at most this many milliseconds. */
  Future<V> poll(long millis)
}

class ExecutorCompletionService<V> implements CompletionService<V> {
  private final Executor executor
  private final List<Future<V>> ready = new ArrayList<Future<V>>()

  public ExecutorCompletionService(Executor executor) {
    if (executor == null) {
      throw new NullPointerException("the executor is null")
    }
    this.executor = executor
  }

  public Future<V> submit(Callable<V> task) {
    if (task == null) {
      throw new NullPointerException("the task is null")
    }
    final FutureTask<V> future = new FutureTask<V>(task)
    final ExecutorCompletionService<V> self = this
    /* A Runnable, because the pool's execute() takes one and the future keeps
       its own answer. Running future.run() here is what Java's queueing
       decorator does: the task runs on the pool, and the wrapper only notices
       that it finished. */
    Runnable wrapper = new Runnable() {
      public void run() {
        future.run()
        self.finished(future)
      }
    }
    this.executor.execute(wrapper)
    return future
  }

  private void finished(Future<V> future) {
    synchronized (this) {
      this.ready.add(future)
      this.notifyAll()
    }
  }

  public Future<V> take() {
    synchronized (this) {
      while (this.ready.size() == 0) {
        this.wait(-1L)
      }
      Future<V> f = this.ready.get(0)
      this.ready.remove(0)
      return f
    }
  }

  public Future<V> poll() {
    synchronized (this) {
      if (this.ready.size() == 0) {
        return null
      }
      Future<V> f = this.ready.get(0)
      this.ready.remove(0)
      return f
    }
  }

  public Future<V> poll(long millis) {
    long deadline = System.nanoTime() + millis * 1000000L
    synchronized (this) {
      while (this.ready.size() == 0) {
        long left = deadline - System.nanoTime()
        if (left <= 0) {
          return null
        }
        long ms = left / 1000000L
        if (ms <= 0) {
          ms = 1
        }
        this.wait(ms)
      }
      Future<V> f = this.ready.get(0)
      this.ready.remove(0)
      return f
    }
  }
}

class Executors {
  /* For the thread names. Java starts at 1 and numbers pools within the
     process; so does this. */
  private static int pools = 0

  private Executors() {}

  /* Called by the three factories. Threads are named the way
     java.util.concurrent names them -- pool-N-thread-M -- so a thread dump
     reads the same. */
  private static ExecutorService newPool(int core, long keepAlive) {
    Executors.pools = Executors.pools + 1
    return new ThreadPool(core, keepAlive, "pool-" + Executors.pools + "-thread-")
  }

  private static ExecutorService newPool(int core, long keepAlive, ThreadFactory factory) {
    Executors.pools = Executors.pools + 1
    return new ThreadPool(core, keepAlive, "pool-" + Executors.pools + "-thread-", factory)
  }

  /* Java's default factory: a non-daemon thread named pool-N-thread-M, with M
     counting up from one. */
  public static ThreadFactory defaultThreadFactory() {
    Executors.pools = Executors.pools + 1
    final String prefix = "pool-" + Executors.pools + "-thread-"
    final int[] next = new int[] { 1 }
    return new ThreadFactory() {
      public Thread newThread(Runnable r) {
        int n
        synchronized (next) {
          n = next[0]
          next[0] = next[0] + 1
        }
        return new Thread(r, prefix + n)
      }
    }
  }

  /* A pool of exactly this many threads, with every one of them started before
     the constructor returns. A pool of zero or fewer is an
     IllegalArgumentException, as it is in Java. */
  public static ExecutorService newFixedThreadPool(int nThreads) {
    if (nThreads <= 0) {
      throw new IllegalArgumentException("pool size must be greater than zero: " + nThreads)
    }
    return Executors.newPool(nThreads, 0L)
  }

  public static ExecutorService newFixedThreadPool(int nThreads, ThreadFactory factory) {
    if (nThreads <= 0) {
      throw new IllegalArgumentException("pool size must be greater than zero: " + nThreads)
    }
    return Executors.newPool(nThreads, 0L, factory)
  }

  /* A pool of exactly one thread, which is a fixed pool of one and nothing
     more: Java's single-thread executor also wraps every task so that a later
     one cannot run before an earlier one has finished, and taking from one
     queue in order with one worker gives that here. */
  public static ExecutorService newSingleThreadExecutor() {
    return Executors.newPool(1, 0L)
  }

  public static ExecutorService newSingleThreadExecutor(ThreadFactory factory) {
    return Executors.newPool(1, 0L, factory)
  }

  /* The unbounded pool: one worker per task that arrives with none idle, each
     of them leaving after 60 seconds with nothing to do. */
  public static ExecutorService newCachedThreadPool() {
    return Executors.newPool(0, 60000L)
  }

  public static ExecutorService newCachedThreadPool(ThreadFactory factory) {
    return Executors.newPool(0, 60000L, factory)
  }
}
