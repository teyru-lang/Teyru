package teyru

/* java.util, in Teyru.
 *
 * This file holds the interfaces and the two containers that were here before
 * (ArrayList, HashMap); the rest of the package -- the sets, the linked and
 * tree maps, the deque, Arrays, Collections, Objects, Optional, StringJoiner --
 * is in lib/14_util_*.teyru.
 *
 * The split is not decoration. The C backend writes a class's interface table
 * next to the class, so every supertype has to be declared before the type
 * that names it: `class TreeMap implements NavigableMap` in a later file is
 * fine, `interface List<T> extends Collection<T>` with Collection declared
 * later is not. Interfaces therefore live here, implementations there.
 *
 * Two deliberate departures from the JDK's declarations, both forced by the
 * dialect and both invisible to a Java client:
 *
 *   - Java's Collection, Set and Map do not declare equals/hashCode/toString;
 *     Object's are inherited. Teyru resolves a member on an interface-typed
 *     receiver against that interface's own members, so `c.equals(other)` on a
 *     `Collection<T> c` would not compile. They are declared here, and the
 *     contract is Java's (List: element-wise; Set: set equality; Map:
 *     entry-wise).
 *   - Comparator is declared in lib/09_functional.teyru, which this library
 *     does not own and cannot extend, so the JDK's static factories
 *     (Comparator.comparing, naturalOrder, reverseOrder, thenComparing) cannot
 *     be attached to it. Collections.reverseOrder() is here, because in the
 *     JDK that one is on Collections; the rest are missing, not stubbed.
 *     `Comparator<? super T>` is spelled `Comparator<T>` throughout: Teyru does
 *     not infer a lambda's parameter types through a wildcard, and
 *     `list.sort((a, b) -> ...)` has to work.
 */

// ---------------------------------------------------------------- Collection

interface Collection<T> extends Iterable<T> {
  int size()
  boolean isEmpty()
  /* Java takes Object, not T, in these: a List<String> has to answer
     contains("x"), and a List<Object> holding a String has to answer
     contains(thatString) too. */
  boolean contains(Object o)
  Object[] toArray()
  boolean add(T e)
  boolean remove(Object o)
  boolean containsAll(Collection<?> c)
  boolean addAll(Collection<? extends T> c)
  boolean removeAll(Collection<?> c)
  boolean retainAll(Collection<?> c)
  void clear()
  boolean equals(Object o)
  int hashCode()
  String toString()

  /* Java's two entry points to a stream. `parallelStream` returns a sequential
     stream here, which is what `parallel()` does on one: this language has no
     threads for a stream to be parallel over, and a program that asks for one
     still gets every element in the same order. */
  default Stream<T> stream() {
    return Streams.of(this)
  }

  default Stream<T> parallelStream() {
    return Streams.of(this)
  }

  default void forEach(Consumer<T> action) {
    for (T e : this) {
      action.accept(e)
    }
  }

  /* Java removes through Iterator.remove, which this library does not have:
     Iterator is declared in lib/01_core.teyru with two methods and is not this
     file's to widen. Collecting the matches first and calling removeAll is
     equivalent for every predicate that is a function of the element, which is
     what removeIf is specified to be. */
  default boolean removeIf(Predicate<T> filter) {
    List<T> victims = new ArrayList<T>()
    for (T e : this) {
      if (filter.test(e)) {
        victims.add(e)
      }
    }
    return removeAll(victims)
  }
}

/* Java's ListIterator is declared here rather than in lib/01 next to Iterator
   because it is the only way to remove an element while walking a collection:
   Iterator.remove() cannot be added to the lib/01 interface. */
interface ListIterator<T> extends Iterator<T> {
  boolean hasPrevious()
  T previous()
  int nextIndex()
  int previousIndex()
  void remove()
  void set(T e)
  void add(T e)
}

interface List<T> extends Collection<T> {
  T get(int index)
  T set(int index, T element)
  void add(int index, T element)
  T remove(int index)
  int indexOf(Object o)
  int lastIndexOf(Object o)
  ListIterator<T> listIterator()
  ListIterator<T> listIterator(int index)
  List<T> subList(int fromIndex, int toIndex)
  boolean addAll(int index, Collection<? extends T> c)

  /* Java's List.of: an immutable list of the arguments, and null-hostile --
     a null element is a NullPointerException at the call rather than a list
     that fails later. The JDK spells out one overload per arity up to ten to
     avoid building an array; one variable-arity method does the same job here
     and is what every call ends up at anyway. */
  static <E> List<E> of(E... elements) {
    List<E> out = new ArrayList<E>()
    for (E e : elements) {
      if (e == null) {
        throw new NullPointerException()
      }
      out.add(e)
    }
    return Collections.unmodifiableList(out)
  }

  /* Java's List.sort: copy to an array, sort it, write it back through the
     list iterator. Arrays.sort and Collections.sort both end up here, so the
     library has one merge sort rather than three. TimSort and this agree on
     the only thing that shows: stability. */
  default void sort(Comparator<T> c) {
    Object[] a = toArray()
    mergeSort(a, c)
    ListIterator<T> it = listIterator()
    for (int i = 0 : i < a.length : i++) {
      it.next()
      it.set((T) a[i])
    }
  }

  private static <E> void mergeSort(Object[] a, Comparator<E> c) {
    Object[] buf = new Object[a.length]
    merge(a, buf, 0, a.length, c)
  }

  private static <E> void merge(Object[] a, Object[] buf, int lo, int hi, Comparator<E> c) {
    if (hi - lo < 2) {
      return
    }
    int mid = lo + (hi - lo) / 2
    merge(a, buf, lo, mid, c)
    merge(a, buf, mid, hi, c)
    // the two runs are already in order, so this merge would be a copy
    if (c.compare((E) a[mid - 1], (E) a[mid]) <= 0) {
      return
    }
    for (int i = lo : i < hi : i++) {
      buf[i] = a[i]
    }
    int i = lo
    int j = mid
    for (int k = lo : k < hi : k++) {
      if (i >= mid) {
        a[k] = buf[j]
        j++
      } else if (j >= hi) {
        a[k] = buf[i]
        i++
      } else if (c.compare((E) buf[j], (E) buf[i]) < 0) {
        a[k] = buf[j]
        j++
      } else {
        // <= takes the left run's element, which is what makes this stable
        a[k] = buf[i]
        i++
      }
    }
  }
}

// ---------------------------------------------------------------------- Sets

interface Set<T> extends Collection<T> {
  /* Java's Set.of rejects duplicates as well as nulls: a set of two equal
     elements is a mistake at the call, not a set of one. */
  static <E> Set<E> of(E... elements) {
    Set<E> out = new LinkedHashSet<E>()
    for (E e : elements) {
      if (e == null) {
        throw new NullPointerException()
      }
      if (out.contains(e)) {
        throw new IllegalArgumentException("duplicate element: " + e)
      }
      out.add(e)
    }
    return Collections.unmodifiableSet(out)
  }

  boolean equals(Object o)
  int hashCode()
}

interface SortedSet<T> extends Set<T> {
  Comparator<T> comparator()
  T first()
  T last()
  SortedSet<T> subSet(T fromElement, T toElement)
  SortedSet<T> headSet(T toElement)
  SortedSet<T> tailSet(T fromElement)
}

interface NavigableSet<T> extends SortedSet<T> {
  T lower(T e)
  T floor(T e)
  T ceiling(T e)
  T higher(T e)
  T pollFirst()
  T pollLast()
  Iterator<T> descendingIterator()
  NavigableSet<T> descendingSet()
  NavigableSet<T> subSet(T fromElement, boolean fromInclusive, T toElement, boolean toInclusive)
  NavigableSet<T> headSet(T toElement, boolean inclusive)
  NavigableSet<T> tailSet(T fromElement, boolean inclusive)
}

// --------------------------------------------------------- Queues and deques

interface Queue<T> extends Collection<T> {
  boolean offer(T e)
  T remove()
  T poll()
  T element()
  T peek()
}

interface Deque<T> extends Queue<T> {
  void addFirst(T e)
  void addLast(T e)
  boolean offerFirst(T e)
  boolean offerLast(T e)
  T removeFirst()
  T removeLast()
  T pollFirst()
  T pollLast()
  T getFirst()
  T getLast()
  T peekFirst()
  T peekLast()
  boolean removeFirstOccurrence(Object o)
  boolean removeLastOccurrence(Object o)
  void push(T e)
  T pop()
  Iterator<T> descendingIterator()
}

// --------------------------------------------------------------------- Maps

interface Map<K, V> {
  interface Entry<K, V> {
    K getKey()
    V getValue()
    V setValue(V value)
    boolean equals(Object o)
    int hashCode()
    String toString()
  }

  int size()
  boolean isEmpty()
  boolean containsKey(Object key)
  boolean containsValue(Object value)
  V get(Object key)
  V put(K key, V value)
  V remove(Object key)
  void putAll(Map<? extends K, ? extends V> m)
  void clear()
  /* Java's Map.of takes up to ten key/value pairs as separate arguments, which
     this language can only spell as fixed arities; ofEntries takes the pairs
     the way the JDK's own varargs form does. Both are null-hostile and both
     reject a repeated key, as Java's do. */
  static <K, V> Map<K, V> of() {
    return Collections.unmodifiableMap(new LinkedHashMap<K, V>())
  }

  static <K, V> Map<K, V> of(K k1, V v1) {
    Map<K, V> out = new LinkedHashMap<K, V>()
    putNew(out, k1, v1)
    return Collections.unmodifiableMap(out)
  }

  static <K, V> Map<K, V> of(K k1, V v1, K k2, V v2) {
    Map<K, V> out = new LinkedHashMap<K, V>()
    putNew(out, k1, v1)
    putNew(out, k2, v2)
    return Collections.unmodifiableMap(out)
  }

  static <K, V> Map<K, V> of(K k1, V v1, K k2, V v2, K k3, V v3) {
    Map<K, V> out = new LinkedHashMap<K, V>()
    putNew(out, k1, v1)
    putNew(out, k2, v2)
    putNew(out, k3, v3)
    return Collections.unmodifiableMap(out)
  }

  static <K, V> Map<K, V> ofEntries(Entry<? extends K, ? extends V>... entries) {
    Map<K, V> out = new LinkedHashMap<K, V>()
    for (Entry<? extends K, ? extends V> e : entries) {
      if (e == null || e.getKey() == null || e.getValue() == null) {
        throw new NullPointerException()
      }
      putNew(out, e.getKey(), e.getValue())
    }
    return Collections.unmodifiableMap(out)
  }

  static <K, V> Entry<K, V> entry(K k, V v) {
    if (k == null || v == null) {
      throw new NullPointerException()
    }
    return new SimpleEntry<K, V>(k, v)
  }

  private static <K, V> void putNew(Map<K, V> m, K k, V v) {
    if (k == null || v == null) {
      throw new NullPointerException()
    }
    if (m.containsKey(k)) {
      throw new IllegalArgumentException("duplicate key: " + k)
    }
    m.put(k, v)
  }

  Set<K> keySet()
  /* Java returns Collection<V> here. Teyru's standard library shipped List<V>
     -- it had no Collection interface to return -- and programs are written
     against that, so the narrower type stays. Every Java client still
     compiles: a List<V> is a Collection<V>. */
  List<V> values()
  Set<Entry<K, V>> entrySet()
  boolean equals(Object o)
  int hashCode()
  String toString()

  default V getOrDefault(Object key, V defaultValue) {
    V v = get(key)
    return v != null ? v : defaultValue
  }

  /* Java writes this as get/put and returns the old value, so a key that is
     present with a null value is overwritten: on this interface null means
     absent. */
  default V putIfAbsent(K key, V value) {
    V v = get(key)
    if (v == null) {
      put(key, value)
    }
    return v
  }

  default boolean remove(Object key, Object value) {
    V cur = get(key)
    if (!Objects.equals(cur, value) || (cur == null && !containsKey(key))) {
      return false
    }
    remove(key)
    return true
  }

  default boolean replace(K key, V oldValue, V newValue) {
    V cur = get(key)
    if (cur == null && !containsKey(key)) {
      return false
    }
    if (!Objects.equals(cur, oldValue)) {
      return false
    }
    put(key, newValue)
    return true
  }

  default V replace(K key, V value) {
    if (containsKey(key)) {
      return put(key, value)
    }
    return null
  }

  default V computeIfAbsent(K key, Function<K, V> mappingFunction) {
    V v = get(key)
    if (v != null || containsKey(key)) {
      return v
    }
    V made = mappingFunction.apply(key)
    if (made != null) {
      put(key, made)
    }
    return made
  }

  default V computeIfPresent(K key, BiFunction<K, V, V> remappingFunction) {
    V v = get(key)
    if (v == null) {
      return null
    }
    V made = remappingFunction.apply(key, v)
    if (made == null) {
      remove(key)
    } else {
      put(key, made)
    }
    return made
  }

  default V compute(K key, BiFunction<K, V, V> remappingFunction) {
    V v = get(key)
    V made = remappingFunction.apply(key, v)
    if (made == null) {
      remove(key)
    } else {
      put(key, made)
    }
    return made
  }

  default V merge(K key, V value, BiFunction<V, V, V> remappingFunction) {
    V old = get(key)
    V made = old == null ? value : remappingFunction.apply(old, value)
    if (made == null) {
      remove(key)
    } else {
      put(key, made)
    }
    return made
  }

  default void forEach(BiConsumer<K, V> action) {
    for (Entry<K, V> e : entrySet()) {
      action.accept(e.getKey(), e.getValue())
    }
  }

  default void replaceAll(BiFunction<K, V, V> function) {
    for (Entry<K, V> e : entrySet()) {
      e.setValue(function.apply(e.getKey(), e.getValue()))
    }
  }
}

interface SortedMap<K, V> extends Map<K, V> {
  Comparator<K> comparator()
  K firstKey()
  K lastKey()
  SortedMap<K, V> subMap(K fromKey, K toKey)
  SortedMap<K, V> headMap(K toKey)
  SortedMap<K, V> tailMap(K fromKey)
}

interface NavigableMap<K, V> extends SortedMap<K, V> {
  Entry<K, V> lowerEntry(K key)
  K lowerKey(K key)
  Entry<K, V> floorEntry(K key)
  K floorKey(K key)
  Entry<K, V> ceilingEntry(K key)
  K ceilingKey(K key)
  Entry<K, V> higherEntry(K key)
  K higherKey(K key)
  Entry<K, V> firstEntry()
  Entry<K, V> lastEntry()
  Entry<K, V> pollFirstEntry()
  Entry<K, V> pollLastEntry()
  NavigableMap<K, V> descendingMap()
  NavigableSet<K> navigableKeySet()
  NavigableSet<K> descendingKeySet()
  NavigableMap<K, V> subMap(K fromKey, boolean fromInclusive, K toKey, boolean toInclusive)
  NavigableMap<K, V> headMap(K toKey, boolean inclusive)
  NavigableMap<K, V> tailMap(K fromKey, boolean inclusive)
}

// ----------------------------------------------------------------- ArrayList

class ArrayList<T> implements List<T>, Collection<T> {
  private Object[] items
  private int count

  private static final int DEFAULT_CAPACITY = 10

  public ArrayList() {
    items = new Object[DEFAULT_CAPACITY]
  }

  public ArrayList(int capacity) {
    if (capacity < 0) {
      throw new IllegalArgumentException("negative capacity")
    }
    items = new Object[capacity > 0 ? capacity : 1]
  }

  public ArrayList(Collection<? extends T> c) {
    items = new Object[c.size() > 0 ? c.size() : 1]
    for (Object o : c) {
      add((T) o)
    }
  }

  public int size() {
    return count
  }

  public boolean isEmpty() {
    return count == 0
  }

  // Collection.add reports whether the collection changed; a List always does
  public boolean add(T v) {
    growTo(count + 1)
    items[count] = v
    count++
    return true
  }

  public void add(int index, T element) {
    checkIndexForAdd(index)
    growTo(count + 1)
    for (int i = count : i > index : i--) {
      items[i] = items[i - 1]
    }
    items[index] = element
    count++
  }

  /* Java copies the source with c.toArray() first, which is what makes
     addAll(this) terminate instead of walking a list it is growing. */
  public boolean addAll(Collection<? extends T> other) {
    Object[] a = other.toArray()
    if (a.length == 0) {
      return false
    }
    growTo(count + a.length)
    for (int i = 0 : i < a.length : i++) {
      items[count] = a[i]
      count++
    }
    return true
  }

  public boolean addAll(int index, Collection<? extends T> other) {
    checkIndexForAdd(index)
    Object[] a = other.toArray()
    if (a.length == 0) {
      return false
    }
    growTo(count + a.length)
    for (int i = count - 1 : i >= index : i--) {
      items[i + a.length] = items[i]
    }
    for (int i = 0 : i < a.length : i++) {
      items[index + i] = a[i]
    }
    count += a.length
    return true
  }

  public T get(int i) {
    checkIndex(i)
    return (T) items[i]
  }

  public T set(int i, T v) {
    checkIndex(i)
    T old = (T) items[i]
    items[i] = v
    return old
  }

  public T remove(int index) {
    checkIndex(index)
    return removeAt(index)
  }

  // removes the first element equal to v, like Java's List.remove(Object)
  public boolean remove(Object v) {
    int i = indexOf(v)
    if (i < 0) {
      return false
    }
    removeAt(i)
    return true
  }

  private T removeAt(int i) {
    T old = (T) items[i]
    for (int j = i : j < count - 1 : j++) {
      items[j] = items[j + 1]
    }
    count--
    items[count] = null
    return old
  }

  public boolean contains(Object v) {
    return indexOf(v) >= 0
  }

  public int indexOf(Object v) {
    for (int i = 0 : i < count : i++) {
      if (Objects.equals(v, items[i])) {
        return i
      }
    }
    return -1
  }

  public int lastIndexOf(Object v) {
    for (int i = count - 1 : i >= 0 : i--) {
      if (Objects.equals(v, items[i])) {
        return i
      }
    }
    return -1
  }

  public boolean containsAll(Collection<?> c) {
    for (Object o : c) {
      if (!contains(o)) {
        return false
      }
    }
    return true
  }

  public boolean removeAll(Collection<?> c) {
    boolean changed = false
    int i = 0
    while (i < count) {
      if (c.contains(items[i])) {
        removeAt(i)
        changed = true
      } else {
        i++
      }
    }
    return changed
  }

  public boolean retainAll(Collection<?> c) {
    boolean changed = false
    int i = 0
    while (i < count) {
      if (!c.contains(items[i])) {
        removeAt(i)
        changed = true
      } else {
        i++
      }
    }
    return changed
  }

  public void clear() {
    for (int i = 0 : i < count : i++) {
      items[i] = null
    }
    count = 0
  }

  public Object[] toArray() {
    Object[] out = new Object[count]
    for (int i = 0 : i < count : i++) {
      out[i] = items[i]
    }
    return out
  }

  public Iterator<T> iterator() {
    return new ArrayListIterator<T>(this)
  }

  public ListIterator<T> listIterator() {
    return new ArrayListIterator<T>(this)
  }

  public ListIterator<T> listIterator(int index) {
    return new ArrayListIterator<T>(this, index)
  }

  public List<T> subList(int from, int to) {
    if (from < 0 || to > count || from > to) {
      throw new IndexOutOfBoundsException("from " + from + ", to " + to + ", size " + count)
    }
    return new ListSubList<T>(this, from, to)
  }

  /* List.equals: same size, equal elements. Not the identity Object gives --
     and the reason the hashCode below exists, since Java requires the two to
     agree. */
  public boolean equals(Object o) {
    if (o == this) {
      return true
    }
    if (!(o instanceof List)) {
      return false
    }
    List<Object> other = (List<Object>) o
    if (other.size() != count) {
      return false
    }
    Iterator<Object> it = other.iterator()
    for (int i = 0 : i < count : i++) {
      if (!Objects.equals(items[i], it.next())) {
        return false
      }
    }
    return true
  }

  // the List contract: 31 * h + e.hashCode() over the elements, starting at 1
  public int hashCode() {
    int h = 1
    for (int i = 0 : i < count : i++) {
      h = 31 * h + Objects.hashCode(items[i])
    }
    return h
  }

  public String toString() {
    if (count == 0) {
      return "[]"
    }
    StringBuilder sb = new StringBuilder()
    sb.append("[")
    for (int i = 0 : i < count : i++) {
      if (i > 0) {
        sb.append(", ")
      }
      sb.append(items[i])
    }
    sb.append("]")
    return sb.toString()
  }

  private void checkIndex(int i) {
    if (i < 0 || i >= count) {
      throw new IndexOutOfBoundsException("index " + i + ", size " + count)
    }
  }

  private void checkIndexForAdd(int i) {
    if (i < 0 || i > count) {
      throw new IndexOutOfBoundsException("index " + i + ", size " + count)
    }
  }

  private void growTo(int needed) {
    if (needed <= items.length) {
      return
    }
    int bigger = items.length + (items.length >> 1)
    if (bigger < needed) {
      bigger = needed
    }
    Object[] next = new Object[bigger]
    for (int i = 0 : i < count : i++) {
      next[i] = items[i]
    }
    items = next
  }
}

class ArrayListIterator<T> implements ListIterator<T>, Iterator<T> {
  private ArrayList<T> list
  private int cursor
  private int lastRet = -1

  public ArrayListIterator(ArrayList<T> l) {
    list = l
  }

  public ArrayListIterator(ArrayList<T> l, int index) {
    list = l
    cursor = index
  }

  public boolean hasNext() {
    return cursor < list.size()
  }

  public T next() {
    if (!hasNext()) {
      throw new NoSuchElementException("no more elements")
    }
    T v = list.get(cursor)
    lastRet = cursor
    cursor++
    return v
  }

  public boolean hasPrevious() {
    return cursor > 0
  }

  public T previous() {
    if (!hasPrevious()) {
      throw new NoSuchElementException("no more elements")
    }
    cursor--
    lastRet = cursor
    return list.get(cursor)
  }

  public int nextIndex() {
    return cursor
  }

  public int previousIndex() {
    return cursor - 1
  }

  public void remove() {
    if (lastRet < 0) {
      throw new IllegalStateException("remove() before next()")
    }
    list.remove(lastRet)
    cursor = lastRet
    lastRet = -1
  }

  public void set(T e) {
    if (lastRet < 0) {
      throw new IllegalStateException("set() before next()")
    }
    list.set(lastRet, e)
  }

  public void add(T e) {
    list.add(cursor, e)
    cursor++
    lastRet = -1
  }
}

// ------------------------------------------------------------------- HashMap

/* One node of the chained table, and a Map.Entry.
 *
 * before/after are the insertion-order links. A plain HashMap never reads
 * them; LinkedHashMap does. Every insert and remove maintains them for every
 * map, so that LinkedHashMap is a subclass which only chooses a different
 * iteration order -- the alternative, a second node type and a factory, costs
 * more in this dialect than two unused pointers per entry. */
class HashEntry<K, V> implements Map.Entry<K, V> {
  K key
  V value
  int hash
  HashEntry<K, V> next
  HashEntry<K, V> before
  HashEntry<K, V> after

  HashEntry(int hash, K key, V value) {
    this.hash = hash
    this.key = key
    this.value = value
  }

  public K getKey() {
    return key
  }

  public V getValue() {
    return value
  }

  public V setValue(V v) {
    V old = value
    value = v
    return old
  }

  public boolean equals(Object o) {
    if (o == this) {
      return true
    }
    if (!(o instanceof Map.Entry)) {
      return false
    }
    Map.Entry<Object, Object> e = (Map.Entry<Object, Object>) o
    return Objects.equals(key, e.getKey()) && Objects.equals(value, e.getValue())
  }

  // the Map.Entry contract: key.hashCode() ^ value.hashCode()
  public int hashCode() {
    return Objects.hashCode(key) ^ Objects.hashCode(value)
  }

  public String toString() {
    return String.valueOf((Object) key) + "=" + String.valueOf((Object) value)
  }
}

class HashMap<K, V> implements Map<K, V> {
  /* Java's HashMap: chained bins, capacity a power of two, index taken from
     the spread hash, new entries appended to the tail of their bin, and bins
     doubled on resize by splitting each one in place. None of that is
     specified -- iteration order is explicitly unspecified -- but all of it is
     observable, and reproducing it is what lets this map's order be checked
     against javac instead of against itself.

     What that costs is the one thing Java does that this does not: a bin of
     eight or more entries treeifies once the table has 64 slots
     (TREEIFY_THRESHOLD), and treeifyBin moves the tree's root to the front of
     the bin -- so the walk order of such a bin is the tree's shape rather than
     its insert order. Reproducing that would mean reproducing the red-black
     tree, and for keys that are neither Comparable nor distinguishable by hash
     Java breaks the tie with System.identityHashCode, which is not
     reproducible in principle. Nothing below 64 slots treeifies, so a table
     that small walks in Java's order whatever its keys are. */
  private Object[] table
  private int count
  private int threshold
  /* float, as Java's is: the field is read as a double where a threshold is
     computed from it, and a float load factor is what the JDK multiplies by. */
  private float loadFactor = DEFAULT_LOAD_FACTOR

  /* Insertion order, or access order in a LinkedHashMap with accessOrder set;
     both are maintained by the base class, see linkNode/unlinkNode.
     Package-visible rather than private: a LinkedHashMap reads `tail` to move
     an accessed node to the end, and the iterators start at `head`. */
  HashEntry<K, V> head
  HashEntry<K, V> tail

  private static final int DEFAULT_CAPACITY = 16
  // 0.75f, as Java's constant is: the field it initializes is a float
  private static final float DEFAULT_LOAD_FACTOR = 0.75f

  public HashMap() {
  }

  public HashMap(int initialCapacity) {
    if (initialCapacity < 0) {
      throw new IllegalArgumentException("negative capacity")
    }
    // Java stashes the capacity in threshold and builds the table on the first
    // put, so an empty map allocates nothing
    threshold = tableSizeFor(initialCapacity)
  }

  public HashMap(int initialCapacity, float factor) {
    if (initialCapacity < 0) {
      throw new IllegalArgumentException("negative capacity")
    }
    if (factor <= 0) {
      throw new IllegalArgumentException("illegal load factor")
    }
    loadFactor = factor
    threshold = tableSizeFor(initialCapacity)
  }

  public HashMap(Map<? extends K, ? extends V> m) {
    putAll(m)
  }

  public int size() {
    return count
  }

  public boolean isEmpty() {
    return count == 0
  }

  public boolean containsKey(Object key) {
    return findEntry(key) != null
  }

  public boolean containsValue(Object value) {
    for (HashEntry<K, V> e = head : e != null : e = e.after) {
      if (Objects.equals(value, e.value)) {
        return true
      }
    }
    return false
  }

  public V get(Object key) {
    HashEntry<K, V> e = findEntry(key)
    if (e == null) {
      return null
    }
    afterNodeAccess(e)
    return e.value
  }

  public V put(K key, V value) {
    if (table == null) {
      resize()
    }
    int hash = hashOf(key)
    HashEntry<K, V> e = findEntry(key)
    if (e != null) {
      V old = e.value
      e.value = value
      afterNodeAccess(e)
      return old
    }
    int index = hash & (table.length - 1)
    e = new HashEntry<K, V>(hash, key, value)
    /* Appended to the bin's tail rather than prepended to its head, which is
       what Java 8 does and what makes a bin walk in insert order. Java 7
       prepended, and that is one of the two reasons this map's order did not
       match the JDK's. */
    HashEntry<K, V> last = (HashEntry<K, V>) table[index]
    if (last == null) {
      table[index] = e
    } else {
      while (last.next != null) {
        last = last.next
      }
      last.next = e
    }
    linkNode(e)
    count++
    afterNodeInsertion(true)
    if (count > threshold) {
      resize()
    }
    return null
  }

  public void putAll(Map<? extends K, ? extends V> m) {
    int s = m.size()
    if (s > 0 && table == null) {
      /* Java's putMapEntries sizes a map that has no table yet from the source
         rather than leaving it at the default 16: ceil(size / loadFactor)
         rounded up to a power of two. Both the capacity and the threshold it
         leaves differ from letting the first put build the default table --
         and the capacity is what decides the bins, so the walk order differs
         with it. (The other half of Java's rule, resizing first when the source
         is already larger than the threshold, is not here because it is not
         observable: it doubles the same threshold the inserts would have
         doubled, one entry earlier, and the entries are the same either way.) */
      double wanted = (double) s / loadFactor
      int t = (int) wanted
      if ((double) t < wanted) {
        t++
      }
      int cap = tableSizeFor(t)
      if (cap > threshold) {
        threshold = cap
      }
    }
    for (Object k : m.keySet()) {
      put((K) k, (V) m.get(k))
    }
  }

  public V remove(Object key) {
    HashEntry<K, V> e = findEntry(key)
    if (e == null) {
      return null
    }
    V old = e.value
    removeEntry(e)
    return old
  }

  public void clear() {
    for (int i = 0 : table != null && i < table.length : i++) {
      table[i] = null
    }
    count = 0
    head = null
    tail = null
  }

  public Set<K> keySet() {
    return new MapKeySet<K, V>(this, entrySet())
  }

  public List<V> values() {
    return new MapValues<K, V>(this, entrySet())
  }

  public Set<Map.Entry<K, V>> entrySet() {
    return new HashMapEntrySet<K, V>(this)
  }

  /* The iteration order a map hands its views. HashMap walks the bins;
     LinkedHashMap walks the links, which is insertion order. Everything the
     views do goes through this one method. */
  protected ListIterator<Map.Entry<K, V>> entryIterator() {
    return new HashMapIterator<K, V>(this)
  }

  protected HashEntry<K, V> firstInTable(int index) {
    return (HashEntry<K, V>) table[index]
  }

  protected int tableLength() {
    return table == null ? 0 : table.length
  }

  protected HashEntry<K, V> firstEntry() {
    return table == null ? null : head
  }

  /* Java's three hooks, called unconditionally here. HashMap's are empty;
     LinkedHashMap overrides them to move an accessed node to the tail, to drop
     the eldest entry, and to unlink a removed one. */
  protected void afterNodeAccess(HashEntry<K, V> e) {
  }

  protected void afterNodeInsertion(boolean evict) {
  }

  protected void afterNodeRemoval(HashEntry<K, V> e) {
  }

  protected void linkNode(HashEntry<K, V> e) {
    if (head == null) {
      head = e
    } else {
      tail.after = e
      e.before = tail
    }
    tail = e
  }

  protected void unlinkNode(HashEntry<K, V> e) {
    if (e.before != null) {
      e.before.after = e.after
    } else {
      head = e.after
    }
    if (e.after != null) {
      e.after.before = e.before
    } else {
      tail = e.before
    }
    e.before = null
    e.after = null
  }

  protected HashEntry<K, V> eldestEntry() {
    return head
  }

  protected void removeFirstEntry() {
    if (head != null) {
      removeEntry(head)
    }
  }

  /* protected because the iterators remove through it: it is the map's own
     unlink, and a view's remove has to go through it rather than around it. */
  protected void removeEntry(HashEntry<K, V> e) {
    int index = e.hash & (table.length - 1)
    HashEntry<K, V> prev = null
    HashEntry<K, V> cur = (HashEntry<K, V>) table[index]
    while (cur != null) {
      if (cur == e) {
        if (prev == null) {
          table[index] = cur.next
        } else {
          prev.next = cur.next
        }
        break
      }
      prev = cur
      cur = cur.next
    }
    count--
    unlinkNode(e)
    afterNodeRemoval(e)
  }

  /* Package-visible rather than private: the entry set needs to find the node
     behind a key to remove it, and the JDK's EntrySet is in the same position. */
  HashEntry<K, V> findEntry(Object key) {
    if (table == null) {
      return null
    }
    int hash = hashOf(key)
    for (HashEntry<K, V> e = (HashEntry<K, V>) table[hash & (table.length - 1)] : e != null : e = e.next) {
      if (e.hash == hash && (e.key == key || (key != null && key.equals(e.key)))) {
        return e
      }
    }
    return null
  }

  /* Java's spread: the top bits of the hash reach the low bits of the index,
     which is what keeps a batch of keys that differ only above the mask out of
     one bin. A null key hashes to 0 and lives in bin 0, exactly as in Java:
     HashMap accepts one null key. */
  private static int hashOf(Object key) {
    if (key == null) {
      return 0
    }
    int h = key.hashCode()
    return h ^ (h >>> 16)
  }

  private void resize() {
    Object[] old = table
    int oldCap = old == null ? 0 : old.length
    int newCap
    int newThr = 0
    if (oldCap > 0) {
      newCap = oldCap * 2
      /* Java doubles the threshold rather than recomputing it once the table
         has grown at least once, and the two are not the same number when the
         load factor does not divide the capacity: 0.6 over 16 slots is 9, and
         the next threshold is 18 rather than (int) (32 * 0.6) = 19. The
         difference moves the growth after that, which moves the bins. */
      if (oldCap >= DEFAULT_CAPACITY) {
        newThr = threshold * 2
      }
    } else if (threshold > 0) {
      // the capacity a constructor stashed; the threshold follows below
      newCap = threshold
    } else {
      newCap = DEFAULT_CAPACITY
    }
    if (newThr == 0) {
      newThr = (int) (newCap * loadFactor)
    }
    Object[] next = new Object[newCap]
    if (old != null) {
      for (int i = 0 : i < oldCap : i++) {
        HashEntry<K, V> e = (HashEntry<K, V>) old[i]
        if (e == null) {
          continue
        }
        // a bin splits into the same index and that index plus oldCap,
        // keeping the relative order of both halves
        HashEntry<K, V> loHead = null
        HashEntry<K, V> loTail = null
        HashEntry<K, V> hiHead = null
        HashEntry<K, V> hiTail = null
        while (e != null) {
          HashEntry<K, V> nx = e.next
          e.next = null
          if ((e.hash & oldCap) == 0) {
            if (loTail == null) {
              loHead = e
            } else {
              loTail.next = e
            }
            loTail = e
          } else {
            if (hiTail == null) {
              hiHead = e
            } else {
              hiTail.next = e
            }
            hiTail = e
          }
          e = nx
        }
        next[i] = loHead
        if (i + oldCap < newCap) {
          next[i + oldCap] = hiHead
        }
      }
    }
    table = next
    threshold = newThr
  }

  // the smallest power of two that is at least cap, never less than 1
  private static int tableSizeFor(int cap) {
    int n = 1
    while (n < cap) {
      n = n << 1
    }
    return n
  }

  public boolean equals(Object o) {
    if (o == this) {
      return true
    }
    if (!(o instanceof Map)) {
      return false
    }
    Map<Object, Object> other = (Map<Object, Object>) o
    if (other.size() != count) {
      return false
    }
    for (HashEntry<K, V> e = head : e != null : e = e.after) {
      if (!other.containsKey(e.key)) {
        return false
      }
      if (!Objects.equals(e.value, other.get(e.key))) {
        return false
      }
    }
    return true
  }

  // the Map contract: the sum of the entries' hashCodes
  public int hashCode() {
    int h = 0
    for (HashEntry<K, V> e = head : e != null : e = e.after) {
      h += e.hashCode()
    }
    return h
  }

  public String toString() {
    if (count == 0) {
      return "{}"
    }
    StringBuilder sb = new StringBuilder()
    sb.append("{")
    boolean first = true
    /* Through the map's own entry iterator, which is what Java's
       AbstractMap.toString does: HashMap walks the bins, LinkedHashMap walks
       its insertion links, and the order a map prints is the order it walks.
       Walking `head` here is what made a HashMap print in insertion order. */
    Iterator<Map.Entry<K, V>> it = entryIterator()
    while (it.hasNext()) {
      if (!first) {
        sb.append(", ")
      }
      sb.append(it.next())
      first = false
    }
    sb.append("}")
    return sb.toString()
  }
}

/* Walks a HashMap's bins. LinkedHashMap replaces this with a walk of the
   insertion-order links. */
class HashMapIterator<K, V> implements ListIterator<Map.Entry<K, V>>, Iterator<Map.Entry<K, V>> {
  private HashMap<K, V> map
  private int bin
  private HashEntry<K, V> next
  private HashEntry<K, V> lastRet

  public HashMapIterator(HashMap<K, V> m) {
    map = m
  }

  public boolean hasNext() {
    while (next == null && bin < map.tableLength()) {
      next = map.firstInTable(bin)
      bin++
    }
    return next != null
  }

  public Map.Entry<K, V> next() {
    if (!hasNext()) {
      throw new NoSuchElementException("no more elements")
    }
    HashEntry<K, V> e = next
    next = e.next
    lastRet = e
    return e
  }

  // Iterator.remove is not in lib/01's Iterator, but the views remove through
  // this class, which is a ListIterator and therefore has it
  public void remove() {
    if (lastRet == null) {
      throw new IllegalStateException("remove() before next()")
    }
    map.removeEntry(lastRet)
    lastRet = null
  }

  public boolean hasPrevious() {
    throw new UnsupportedOperationException("hasPrevious")
  }

  public Map.Entry<K, V> previous() {
    throw new UnsupportedOperationException("previous")
  }

  public int nextIndex() {
    throw new UnsupportedOperationException("nextIndex")
  }

  public int previousIndex() {
    throw new UnsupportedOperationException("previousIndex")
  }

  public void set(Map.Entry<K, V> e) {
    throw new UnsupportedOperationException()
  }

  public void add(Map.Entry<K, V> e) {
    throw new UnsupportedOperationException()
  }
}

/* The immutable entry Map.entry returns, which is Java's AbstractMap.SimpleEntry
   under the name the JDK's own Map.ofEntries uses internally. */
class SimpleEntry<K, V> implements Map.Entry<K, V> {
  private K key
  private V value

  public SimpleEntry(K key, V value) {
    this.key = key
    this.value = value
  }

  public K getKey() {
    return key
  }

  public V getValue() {
    return value
  }

  public V setValue(V v) {
    V old = value
    value = v
    return old
  }

  public boolean equals(Object o) {
    if (o == this) {
      return true
    }
    if (!(o instanceof Map.Entry)) {
      return false
    }
    Map.Entry<K, V> e = (Map.Entry<K, V>) o
    return Objects.equals(key, e.getKey()) && Objects.equals(value, e.getValue())
  }

  public int hashCode() {
    return Objects.hashCode(key) ^ Objects.hashCode(value)
  }

  public String toString() {
    return key + "=" + value
  }
}
